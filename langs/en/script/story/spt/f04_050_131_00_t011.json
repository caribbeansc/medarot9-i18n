  },
  {
   "i": 1259,
   "src": "afe8f8631dd6",
   "t": "What's going on?"
  },
  {
   "i": 1266,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1272,
   "src": "601d47166b5f",
   "t": "Requests to start new clubs"
  },
  {
   "i": 1275,
   "src": "5424dd7e55a6",
   "t": "keep increasing."
  },
  {
   "i": 1283,
   "src": "8d9c5ae9ff0d",
   "t": "But there are no spare clubrooms now."
  },
  {
   "i": 1286,
   "src": "80b17dbb0ebf",
   "t": "We must shut down a {{club}} to free one."
  },
  {
   "i": 1294,
   "src": "1b448cd9f46a",
   "t": "The {{exploration_club}} scored 0 this term."
  },
  {
   "i": 1297,
   "src": "d5ee86166564",
   "t": "That's dead last among all clubs, by far."
  },
  {
   "i": 1305,
   "src": "f842254dcc66",
   "t": "Naturally, the top candidate for closure."
  },
  {
   "i": 1308,
   "src": "3e0bbbe26e8f",
   "t": "To avoid that, you need a big result."
  },
  {
   "i": 1316,
   "src": "e0831c28b539",
