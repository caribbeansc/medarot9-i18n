   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1129,
   "src": "a9c0f6312486",
   "t": "Hey, {{ryoma}}-kun."
  },
  {
   "i": 1140,
   "src": "20f4f9377a07",
   "t": "This is where the meteorite landed,"
  },
  {
   "i": 1143,
   "src": "fb7db9474949",
   "t": "right-- I mean, it's a crater, isn't it?"
  },
