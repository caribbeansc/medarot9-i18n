 "lines": [
  {
   "i": 1039,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1054,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1065,
   "src": "20287d76f44f",
   "t": "That's a {{medalia_fusion}} machine."
  },
  {
   "i": 1079,
   "src": "fed537c5ae87",
   "t": "Hm?"
  },
  {
   "i": 1092,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1103,
   "src": "2b02e47fe036",
   "t": "{{medalia}}, once a single mass of matter,"
  },
  {
   "i": 1106,
   "src": "c7009eb7f9c5",
   "t": "can be fused fairly easily."
  },
  {
   "i": 1114,
   "src": "d9e5e6fce154",
   "t": "Traits gained in each environment could"
  },
  {
   "i": 1117,
   "src": "1a7912d2f9e0",
   "t": "cancel out, which blocked practical use."
  },
  {
   "i": 1132,
   "src": "466e51bd80ab",
   "t": "We finally found the rule."
  },
  {
   "i": 1135,
   "src": "c843da8c497a",
   "t": "It's practical now, so I brought it."
  },
  {
   "i": 1146,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1166,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1177,
   "src": "2c17c424ec9d",
   "t": "It's okay. Even if you do it carelessly,"
  },
  {
   "i": 1180,
   "src": "52810d263483",
   "t": "you'll get stronger."
  },
  {
   "i": 1188,
   "src": "2a8589fe5a63",
   "t": "The total level of the fused {{medalia}}"
  },
  {
   "i": 1191,
   "src": "89785197d75a",
   "t": "becomes the level of the base {{medalia}}."
  },
  {
   "i": 1199,
   "src": "9c162928c848",
   "t": "When you have {{medalia}} you don't use,"
  },
  {
   "i": 1202,
   "src": "feb3296f05de",
   "t": "please give it a try."
  },
  {
   "i": 1213,
   "src": "b7d965cee4b1",
   "t": "Wow..."
  },
  {
   "i": 1216,
   "src": "1b1bea580ab4",
   "t": "Thanks, {{main}}-chan. I'll try it."
  },
  {
   "i": 1228,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1237,
   "src": "052f7bf28a4e",
   "t": "Ah!!!"
  },
  {
   "i": 1255,
   "src": "19ec58bf1185",
   "t": "Whoa!"
  },
  {
   "i": 1263,
   "src": "cd68f1c5b224",
   "t": "W-what?"
  },
  {
   "i": 1268,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1277,
   "src": "31725c9efcb3",
   "t": "I forgot to mention something."
  },
  {
   "i": 1280,
   "src": "03dd2444083b",
   "t": "Please be careful about this one thing."
  },
  {
   "i": 1291,
   "src": "fed537c5ae87",
   "t": "Hm?"
  },
  {
   "i": 1296,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1305,
   "src": "c670c0925c74",
   "t": "Fused {{medalia}} disappear."
  },
  {
   "i": 1308,
   "src": "c6765b069a90",
   "t": "Their skills are lost, too."
  },
  {
   "i": 1323,
   "src": "70732d5eb987",
   "t": "Always use your precious {{medalia}} as the"
  },
  {
   "i": 1326,
   "src": "db3e167a7b93",
   "t": "base. Promise!"
  },
  {
   "i": 1344,
   "src": "5e5d9de9a2cb",
   "t": "O-okay..."
  },
  {
   "i": 1347,
   "src": "ecb9683cddba",
   "t": "Thank you."
  }
 ]
