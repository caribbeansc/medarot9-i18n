  {
   "i": 1024,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1035,
   "src": "0bbb4dd3a451",
   "t": "The {{principal|cap}} did something like that..."
  },
  {
   "i": 1043,
   "src": "d3cbc7024c91",
   "t": "All right, I'll at least ask him to give"
  },
  {
   "i": 1046,
   "src": "e9c941f11987",
   "t": "back that important data."
  },
  {
   "i": 1054,
   "src": "3d4f6fbaee77",
   "t": "Thank you very much!"
  },
  {
   "i": 1059,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1065,
   "src": "9b1b66e42322",
   "t": "Sorry for troubling you again and again."
  },
  {
   "i": 1072,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1078,
   "src": "82599da1feaa",
   "t": "Don't worry about it. But they"
  },
  {
   "i": 1081,
   "src": "265522ac8156",
   "t": "found out awfully fast, didn't they?"
  },
  {
   "i": 1089,
   "src": "d116e974dfd9",
   "t": "Ah, just so you know,"
  },
  {
   "i": 1092,
   "src": "5592f060c647",
   "t": "I didn't say a word."
  },
  {
   "i": 1099,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1105,
   "src": "5c7a24a3a5be",
   "t": "I know."
  },
  {
   "i": 1112,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1118,
   "src": "7b994828a134",
   "t": "Good"
  },
  {
   "i": 1121,
   "src": "4a9a43081103",
   "t": "Now, give me a little time."
  },
  {
   "i": 1129,
   "src": "f7ce4f053c2a",
   "t": "Leave the {{principal|cap}} to me. Enjoy what's"
  },
  {
   "i": 1132,
   "src": "c6c9977a2a55",
   "t": "left of your summer vacation."
  }
 ]
