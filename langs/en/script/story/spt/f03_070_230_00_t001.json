   "t": "{{ryoma}}"
  },
  {
   "i": 1049,
   "src": "589cd20ef050",
   "t": "I see, so that's how it is..."
  },
  {
   "i": 1060,
   "src": "65d1cd1c09dd",
   "t": "What's wrong?"
  },
  {
   "i": 1065,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1071,
   "src": "8039ec2ada04",
   "t": "The fence is broken, see?"
  },
  {
   "i": 1079,
   "src": "270702788466",
   "t": "It wasn't like this before."
  },
  {
   "i": 1082,
   "src": "afd98dd37d75",
   "t": "In other words--"
  },
  {
   "i": 1090,
   "src": "9c2dd818d47d",
   "t": "Until very recently, there was no way"
  },
  {
   "i": 1093,
   "src": "c2e6012c4e52",
   "t": "into the mine entrance from back there."
  },
  {
   "i": 1101,
   "src": "59edc6dab2af",
   "t": "This... didn't break naturally, did it?"
  },
  {
   "i": 1104,
   "src": "59911b49ca56",
   "t": "Did someone break it on purpose...?"
  },
  {
   "i": 1109,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1115,
   "src": "e4751a182444",
   "t": "...Maybe."
  },
  {
   "i": 1125,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1134,
   "src": "ad346ebad4e2",
   "t": "Oh, who cares about that."
  },
  {
   "i": 1145,
   "src": "a949333d72ae",
   "t": "Come on, let's just get going."
  },
  {
   "i": 1148,
   "src": "e7c1829cf2df",
   "t": "I want to hop in the bath already!"
  },
  {
   "i": 1169,
   "src": "2a8905566226",
   "t": "Oh, that thing up ahead, is that..."
  },
  {
   "i": 1172,
   "src": "3f396c205238",
   "t": "...the harbor?"
  },
  {
   "i": 1180,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1186,
   "src": "ddcf0ae44096",
   "t": "It is. Walk a little farther,"
  },
  {
   "i": 1189,
   "src": "c004d8443c4a",
   "t": "and you'll see the school building."
  },
  {
   "i": 1200,
   "src": "e0fc361ae0c5",
   "t": "Let's go!"
  }
 ]
