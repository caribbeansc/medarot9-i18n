{
 "file": "story/spt/f06_260_161_00_t013.spt",
 "lines": [
  {
   "i": 1032,
   "src": "a79c3e558321",
   "t": "{{principal|cap}}!?"
  },
  {
   "i": 1039,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1045,
   "src": "915aafc3af2f",
   "t": "Answer me!"
  },
  {
   "i": 1048,
   "src": "d5a0fb8dd8cb",
   "t": "How did you get the reaction!?"
  },
  {
   "i": 1061,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1069,
   "src": "018b01233aa5",
   "t": "In the basement of the old warehouse,"
  },
  {
   "i": 1072,
   "src": "abddfe62d46f",
   "t": "we found the detector's blueprints."
  },
  {
   "i": 1082,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1088,
   "src": "6ab6e7a9cd63",
   "t": "What?"
  },
  {
   "i": 1095,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1101,
   "src": "72d290c74a53",
   "t": "To be exact, it's a memory crystal"
  },
  {
   "i": 1104,
   "src": "876d20fa282f",
   "t": "with the design data on it."
  },
  {
   "i": 1112,
   "src": "1fea84f0fd4d",
   "t": "It's probably from when the mine\nwas still running."
  },
  {
   "i": 1120,
   "src": "646d0c4462f2",
   "t": "It's on the rack next to the PC."
  },
  {
   "i": 1123,
   "src": "45b4ab4763c0",
   "t": "If you need to check, please feel free--"
  },
  {
   "i": 1130,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1136,
   "src": "d91925360207",
   "t": "Don't dodge the question."
  },
  {
   "i": 1139,
   "src": "d6b222710c58",
   "t": "I don't care about blueprints."
  },
  {
   "i": 1147,
   "src": "aa511aeaef1b",
   "t": "What I'm asking is how you got\nthe {{medalia}} reaction."
  },
  {
   "i": 1160,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1168,
   "src": "2cc1de0907c1",
   "t": "We're using our own detection system."
  },
  {
   "i": 1175,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1181,
   "src": "da59417c634c",
   "t": "Don't lie."
  },
  {
   "i": 1188,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1197,
   "src": "6b2cd65eefa6",
   "t": "It's not a lie!"
  },
  {
   "i": 1208,
   "src": "257d5ff8e453",
   "t": "I analyzed the interference waveform."
  },
  {
   "i": 1211,
   "src": "b85c3d89705e",
   "t": "I added a calculation to cancel it out."
  },
  {
   "i": 1219,
   "src": "9e9db2b7f7e5",
   "t": "Detection works normally now. It can"
  },
  {
   "i": 1222,
   "src": "f0e71b76abab",
   "t": "pick up reactions despite interference."
  },
  {
   "i": 1229,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1238,
   "src": "7c9ad729f37d",
   "t": "...Hmph."
  },
  {
   "i": 1249,
   "src": "78a9aef4822f",
   "t": "So you insist you did it all yourselves."
  },
  {
   "i": 1252,
   "src": "9586f15279a5",
   "t": "Fine, whatever."
  }
 ]
}
