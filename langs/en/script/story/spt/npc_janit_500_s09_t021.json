   "t": "{{janitor_character}}"
  },
  {
   "i": 1038,
   "src": "e93b96e3b648",
   "t": "But what's the deal with those folks?"
  },
  {
   "i": 1041,
   "src": "e83bb9336289",
   "t": "Dressed pitch-black like scarecrows."
  },
  {
   "i": 1049,
   "src": "0933dd6864ff",
   "t": "Lately they roam around like it's normal,"
  },
  {
   "i": 1052,
   "src": "5e6c6e6103f7",
   "t": "but this morning there's a huge crowd."
  },
  {
   "i": 1060,
   "src": "5d380d91278f",
   "t": "They've got port passes, so I can't gripe,"
  },
  {
   "i": 1063,
   "src": "fe1c65b7199d",
   "t": "but they look nothing like school staff."
  },
  {
   "i": 1071,
   "src": "4420e0fa6064",
   "t": "Not like {{conglomerate}} big shots, either."
  },
  {
   "i": 1074,
   "src": "136db9d444d7",
   "t": "Who on earth are they?"
  }
 ]
