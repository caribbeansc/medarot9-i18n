{
 "file": "story/spt/free06_02_02_03_t011.spt",
 "lines": [
  {
   "i": 1041,
   "src": "c1a739c111f7",
   "t": "Ah, a reading..."
  },
  {
   "i": 1046,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1052,
   "src": "20dea4386195",
   "t": "I can see the old mine ruins below that\ncliff over there."
  },
  {
   "i": 1069,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1078,
   "src": "e538f3ada9fd",
   "t": "Hey, you're going all the way down\nthere?"
  },
  {
   "i": 1081,
   "src": "df526fadb711",
   "t": "How!?"
  },
  {
   "i": 1091,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1097,
   "src": "d741a101b3c3",
   "t": "There's a rope."
  },
  {
   "i": 1100,
   "src": "1d468775deaa",
   "t": "If we use it, we can climb down safely."
  },
  {
   "i": 1117,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1123,
   "src": "ea72a3274ac5",
   "t": "A rope? That thing... is it from the\nmining days?"
  },
  {
   "i": 1126,
   "src": "21e33e66370a",
   "t": "From decades ago, right? Right!?"
  },
  {
   "i": 1133,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1139,
   "src": "019bd39e5353",
   "t": "It only looks worn out."
  },
  {
   "i": 1142,
   "src": "3aacf31af4c9",
   "t": "It has a steel core, so it's sturdy."
  }
 ]
}
