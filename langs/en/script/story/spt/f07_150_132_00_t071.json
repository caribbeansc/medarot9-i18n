 "file": "story/spt/f07_150_132_00_t071.spt",
 "lines": [
  {
   "i": 1031,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1042,
   "src": "84bc074582d7",
   "t": "What do you know about it?"
  },
  {
   "i": 1053,
   "src": "d59d28e0f5c4",
   "t": "I-I don't know."
  },
  {
   "i": 1056,
   "src": "e901b1fe0b90",
   "t": "But..."
  },
  {
   "i": 1064,
   "src": "278cb37c6cd5",
   "t": "{{aoi}} said so. She has something she"
  },
  {
   "i": 1067,
   "src": "5f4c86f1a66a",
   "t": "wants to tell {{mio}}."
  },
  {
   "i": 1072,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1081,
   "src": "2cd2c4cc6af6",
   "t": "That's why!"
  },
  {
   "i": 1084,
   "src": "d8aab8e1fbc8",
   "t": "Why would she tell that to you--"
  },
  {
   "i": 1095,
   "src": "5fe9bfb70fc9",
   "t": "I think she was trying to say it."
  },
  {
   "i": 1100,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1109,
   "src": "7c5f89e438a5",
   "t": "!?"
  },
  {
   "i": 1120,
   "src": "00a37c029f67",
   "t": "Wasn't she trying to tell you all along?"
  },
  {
   "i": 1123,
   "src": "a7c6bec862a1",
   "t": "Didn't you keep her from saying it?"
  },
  {
   "i": 1136,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1147,
   "src": "36157647a7fa",
   "t": "What?"
  },
  {
   "i": 1150,
   "src": "19e092700c91",
   "t": "So it's my fault in the end, is it?"
  },
  {
   "i": 1161,
   "src": "4304c4d59d79",
   "t": "That's not it!"
  },
  {
   "i": 1164,
   "src": "76e377823591",
   "t": "What I'm trying to say is--"
  },
  {
   "i": 1176,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1185,
   "src": "238ac6b3dd83",
   "t": "Shut up!"
  },
  {
   "i": 1188,
   "src": "5b6f181b68ee",
   "t": "I said I get it already!"
  }
 ]
