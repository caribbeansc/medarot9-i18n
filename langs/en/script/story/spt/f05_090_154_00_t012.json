  {
   "i": 1190,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1199,
   "src": "cbd56345b8e5",
   "t": "Second round? Who did we face again?"
  },
  {
   "i": 1202,
   "src": "62f0ddd2b252",
   "t": "Ah... the Medabot Research Club, I see."
  },
  {
   "i": 1209,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1218,
   "src": "29ea8facacf3",
   "t": "Why did you come here?"
  },
  {
   "i": 1221,
   "src": "040d1cfc29ce",
   "t": "Did you notice the missing {{part|pl}}?"
  },
  {
   "i": 1235,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1244,
   "src": "d380e91a0a50",
   "t": "Correct."
  },
  {
   "i": 1251,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1260,
   "src": "a178faed932c",
   "t": "I borrowed them for a bit."
  },
  {
   "i": 1263,
   "src": "75b6209b6b63",
   "t": "I will return them soon."
  },
  {
   "i": 1270,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1279,
   "src": "c859d70fac92",
   "t": "Why did you do something like that?"
  },
  {
   "i": 1286,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1295,
   "src": "6138fbbb4600",
   "t": "The match deviated from my prediction."
  },
  {
   "i": 1298,
   "src": "452a37e06f18",
   "t": "I borrowed them to find out why."
  },
  {
   "i": 1313,
   "src": "dc651fed5869",
   "t": "But examining them told me nothing."
  },
  {
   "i": 1316,
