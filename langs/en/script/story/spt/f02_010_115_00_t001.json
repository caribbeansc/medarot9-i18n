{
 "file": "story/spt/f02_010_115_00_t001.spt",
 "lines": [
  {
   "i": 1036,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1047,
   "src": "eae4af808584",
   "t": "Hi there."
  },
  {
   "i": 1058,
   "src": "18e5e4e5e2f1",
   "t": "Whoa,"
  },
  {
   "i": 1061,
   "src": "1a7df2707c2b",
   "t": "you scared me!"
  },
  {
   "i": 1072,
   "src": "d45db5a31109",
   "t": "H-hello, um-"
  },
  {
   "i": 1080,
   "src": "7d5a92aa300c",
   "t": "P-President?"
  },
  {
   "i": 1092,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1098,
   "src": "194a8ee100c1",
   "t": "Yep, that's me."
  },
  {
   "i": 1101,
   "src": "699a5f16e7bb",
   "t": "You remembered me~, I'm glad."
  },
  {
   "i": 1109,
   "src": "33d49625cd63",
   "t": "So, I came to tell you, our new member,"
  },
  {
   "i": 1112,
   "src": "c0c6a044c620",
   "t": "what the club will do from now on."
  },
  {
   "i": 1120,
   "src": "3a4e152f4bbc",
   "t": "I need you to recruit members."
  },
  {
   "i": 1128,
   "src": "bc7881f1c1b4",
   "t": "Recruit members..."
  },
  {
   "i": 1133,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1139,
   "src": "b368003fd97a",
   "t": "That's right."
  },
  {
   "i": 1154,
   "src": "7dc7b28898a7",
   "t": "For some reason, the Council President"
  },
  {
   "i": 1157,
   "src": "3c41dec8c68e",
   "t": "has had us in her sights since we began."
  },
  {
   "i": 1165,
   "src": "e79235a91008",
   "t": "If we don't get more members soon,"
  },
  {
   "i": 1168,
   "src": "344ea935f639",
   "t": "she's threatening to shut us down."
  },
  {
   "i": 1176,
   "src": "8ca8c3ad5d8c",
   "t": "Members..."
  },
  {
   "i": 1179,
   "src": "c1e6cd6261a3",
   "t": "How many do we need?"
  },
  {
   "i": 1184,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1190,
   "src": "ea39d3447889",
   "t": "Oh, it's nothing much."
  },
  {
   "i": 1193,
   "src": "5b4a4fdf8383",
   "t": "Just a few."
  },
  {
   "i": 1208,
   "src": "db47c8fd5252",
   "t": "Four in total seems to be enough,"
  },
  {
   "i": 1211,
   "src": "669deb265797",
   "t": "so we only need two more people."
  },
  {
   "i": 1219,
   "src": "2f01f0d8cb5a",
   "t": "Easy, right?"
  },
  {
   "i": 1234,
   "src": "648c517525f3",
   "t": "Wait a second, please."
  },
  {
   "i": 1242,
   "src": "47bb81ee03e2",
   "t": "You said four in total, and two more,"
  },
  {
   "i": 1245,
   "src": "242f52f1f417",
   "t": "right? Which means..."
  },
  {
   "i": 1253,
   "src": "06140fe08e4a",
   "t": "Could it be the {{exploration_club}} right"
  },
  {
   "i": 1256,
   "src": "3ae139cb7b27",
   "t": "now is just the President and me??"
  },
  {
   "i": 1268,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1274,
   "src": "be8f55742378",
   "t": "Yep."
  },
  {
   "i": 1284,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1289,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1295,
   "src": "b714e91f7bda",
   "t": "Well then, I'm counting on you."
  },
  {
   "i": 1303,
   "src": "6467405f0c92",
   "t": "I have an important meeting now,"
  },
  {
   "i": 1306,
   "src": "1ac9d4c8f2b7",
   "t": "so I have to go..."
  },
  {
   "i": 1314,
   "src": "64f859e0658a",
   "t": "I'm expecting great things. The Club's"
  },
  {
   "i": 1317,
   "src": "042d6a74c273",
   "t": "future is on your shoulders~!"
  },
  {
   "i": 1325,
   "src": "b22d2be84a53",
   "t": "Ah, wai, Presid-"
  }
 ]
}
