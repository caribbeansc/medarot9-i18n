{
 "file": "story/spt/f03_050_230_00_t011.spt",
 "lines": [
  {
   "i": 1032,
   "src": "ddee4427d8c3",
   "t": "Hey, you're that {{medabot}} from back"
  },
  {
   "i": 1035,
   "src": "879e8ab0f62f",
   "t": "then, right?...Or am I wrong!?"
  },
  {
   "i": 1054,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1064,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1073,
   "src": "8f8e5481ac2d",
   "t": "Do you know it?"
  },
  {
   "i": 1084,
   "src": "1cf95029d51f",
   "t": "I don't know..."
  },
  {
   "i": 1092,
   "src": "e408893ef782",
   "t": "Right before I came to this school, I saw"
  },
  {
   "i": 1095,
   "src": "221a8e71faf9",
   "t": "a {{medabot}} that looked a lot like it..."
  },
  {
   "i": 1100,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1106,
   "src": "f95fc7a539b5",
   "t": "Outside the island?"
  },
  {
   "i": 1109,
   "src": "b34edc990242",
   "t": "Then isn't it just a different {{medabot}}?"
  },
  {
   "i": 1120,
   "src": "0651d50ce4eb",
   "t": "If you think about it calmly, you're right."
  },
  {
   "i": 1123,
   "src": "e901b1fe0b90",
   "t": "But..."
  },
  {
   "i": 1128,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1137,
   "src": "1eba7719a0c6",
   "t": "I just noticed"
  },
  {
   "i": 1140,
   "src": "614f11c749ad",
   "t": "...don't they look alike?"
  },
  {
   "i": 1150,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1164,
   "src": "5e325e5d4852",
   "t": "You mean this guy and "
  },
  {
   "i": 1166,
   "src": "6f3a35746329",
   "t": "?"
  },
  {
   "i": 1169,
   "src": "bf8557bca88a",
   "t": "Ah... They do. Both are Kabuto types."
  },
  {
   "i": 1175,
   "src": "5e325e5d4852",
   "t": "This one and "
  },
  {
   "i": 1177,
   "src": "6f3a35746329",
   "t": "?"
  },
  {
   "i": 1180,
   "src": "634ba51a0dee",
   "t": "Ah... They do. Both are Kuwagata types."
  }
 ]
}
