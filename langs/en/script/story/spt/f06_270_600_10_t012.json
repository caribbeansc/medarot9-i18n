 "lines": [
  {
   "i": 1032,
   "src": "a2b1e7832fe2",
   "t": "...Huh?"
  },
  {
   "i": 1041,
   "src": "3a56fd31ee59",
   "t": "!"
  },
  {
   "i": 1062,
   "src": "9cb84c5f2af1",
   "t": "What?"
  },
  {
   "i": 1070,
   "src": "2fe9c93e47d9",
   "t": "Where'd you get that watermelon?"
  },
  {
   "i": 1089,
   "src": "769c3cf06389",
   "t": "Found it."
  },
  {
   "i": 1097,
   "src": "33a409e8c7a0",
   "t": "You found it?"
  },
  {
   "i": 1104,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1110,
   "src": "9a46100b7961",
   "t": "Hold it right there, you!"
  },
  {
   "i": 1118,
   "src": "54906cb2fbdd",
   "t": "{{ryusei}}..."
  },
  {
   "i": 1125,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1131,
   "src": "4fcc88e92278",
   "t": "Ah, I thought he looked familiar..."
  },
  {
   "i": 1134,
   "src": "777e740873ee",
   "t": "So he's your {{medabot}}! "
  },
  {
   "i": 1136,
   "src": "3a56fd31ee59",
   "t": "!"
  },
  {
   "i": 1144,
   "src": "c122540d506e",
   "t": "Using your {{partner}} to steal"
  },
  {
   "i": 1147,
   "src": "8a66b5793303",
   "t": "is the lowest of the low!"
  },
  {
   "i": 1155,
   "src": "87bf648540bc",
   "t": "Steal?"
  },
  {
   "i": 1158,
   "src": "275919942d87",
   "t": "No way, I'd never."
  },
  {
   "i": 1166,
   "src": "7f764ee411ab",
   "t": "Looks like he took it by mistake."
  },
  {
   "i": 1169,
   "src": "fd22f4e51e31",
   "t": "Sorry about that. I'll give it back."
  },
  {
   "i": 1174,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1180,
   "src": "2a502bc0dd7e",
   "t": "By mistake, huh...?"
  },
  {
   "i": 1188,
   "src": "5a409a15e3fd",
   "t": "Don't play dumb."
  },
  {
   "i": 1191,
   "src": "0780efc4536c",
   "t": "You're the one who ordered it!"
  },
  {
   "i": 1199,
   "src": "60ce9dd5e2e5",
   "t": "I'd never give an order like that!"
  },
  {
   "i": 1202,
   "src": "e63617b352f2",
   "t": "Besides--"
  },
  {
   "i": 1210,
   "src": "6fb7c9af7e7b",
   "t": "If it's so important, why leave it out?"
  },
  {
   "i": 1213,
   "src": "c7f327a7ebe4",
   "t": "Lock it up in a safe or something!"
  },
  {
   "i": 1218,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1224,
   "src": "f1219b5c4b01",
   "t": "Oh, now you're getting defensive!"
  },
  {
   "i": 1227,
   "src": "4546e76ed6ff",
   "t": "Thief!"
  },
  {
   "i": 1235,
   "src": "4d47397c8bb1",
   "t": "What did you say?!"
  }
 ]
