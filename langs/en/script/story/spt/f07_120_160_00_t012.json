  },
  {
   "i": 1178,
   "src": "e52ed09e8d1f",
   "t": "Then leave us alone."
  },
  {
   "i": 1183,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1189,
   "src": "b27d05932a51",
   "t": "Still, I like a contest. Time to repay"
  },
  {
   "i": 1192,
   "src": "8c65b2178ba2",
   "t": "that debt from before, once and for all."
  },
  {
   "i": 1200,
   "src": "76ea1442caaa",
   "t": "Again? Whatever. This is just a game,"
  },
  {
   "i": 1203,
   "src": "55ab57e2f8b2",
   "t": "it's not a {{robattle}}--"
  },
  {
   "i": 1211,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1217,
   "src": "f08bd1ef812d",
   "t": "Now, now, "
  },
  {
   "i": 1219,
   "src": "5a0b151c2252",
   "t": "-kun."
  },
  {
   "i": 1230,
   "src": "2f526da01f0e",
   "t": "President."
  },
  {
   "i": 1235,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1241,
   "src": "c4bccce42d1f",
   "t": "You mustn't be rude to the customers."
  },
  {
   "i": 1244,
   "src": "f240f3d5f18a",
