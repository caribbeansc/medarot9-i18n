  },
  {
   "i": 1123,
   "src": "0d578cf8a70c",
   "t": "A lounge?"
  },
  {
   "i": 1126,
   "src": "06ba122b5462",
   "t": "Or an exhibit of lazy {{club}} members?"
  },
  {
   "i": 1134,
   "src": "f2e6238a0c39",
   "t": "...It's a target game."
  },
  {
   "i": 1139,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1145,
   "src": "7498d1e46398",
   "t": "Huh?"
  },
  {
   "i": 1153,
   "src": "a7412e08b8b0",
   "t": "Hit more targets than us and win"
