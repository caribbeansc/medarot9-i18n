   "t": "Let's do it!"
  },
  {
   "i": 1223,
   "src": "b07e604ac6e3",
   "t": "{{rescue_club_pres}}"
  },
  {
   "i": 1229,
   "src": "5621dd8b8d38",
   "t": "All right."
  },
  {
   "i": 1232,
   "src": "ebde7d3320d6",
   "t": "Now, about the rules--"
  },
  {
   "i": 1240,
   "src": "c7e75fdff7de",
   "t": "The period will last until the {{stray}}"
  },
  {
   "i": 1243,
