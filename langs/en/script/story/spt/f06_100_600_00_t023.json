  },
  {
   "i": 1182,
   "src": "53ca85f704c2",
   "t": "Fine with me."
  },
  {
   "i": 1192,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1201,
   "src": "9df602b73a33",
   "t": "Well..."
  },
  {
   "i": 1204,
   "src": "68c6a1e309f8",
   "t": "We were sick of the numbers too."
  },
  {
   "i": 1215,
   "src": "8a3fe620da8c",
   "t": "O-okay, understood."
  },
  {
   "i": 1218,
