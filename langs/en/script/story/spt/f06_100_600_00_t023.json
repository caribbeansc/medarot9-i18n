   "t": "can supervise instead--"
  },
  {
   "i": 1290,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1296,
   "src": "872b401a3185",
   "t": "No, I trust you. You cheating? As absurd"
  },
  {
   "i": 1299,
   "src": "6840037932a5",
   "t": "as pineapple in sweet and sour pork."
  },
  {
   "i": 1306,
   "src": "b07e604ac6e3",
   "t": "{{rescue_club_pres}}"
  },
  {
   "i": 1312,
   "src": "979c83933f71",
   "t": "As a pineapple lover, I can't agree with"
  },
  {
   "i": 1315,
   "src": "77c40ce8aa9a",
   "t": "that, but never mind. Let's begin."
  },
  {
   "i": 1329,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1335,
   "src": "15fe6dedd81a",
   "t": "Let's go! I'll pay back what I owe you"
  },
  {
   "i": 1338,
   "src": "393492e59827",
   "t": "from last time!"
  },
  {
   "i": 1352,
   "src": "20c7843a7345",
   "t": "{{homura}}"
  },
  {
   "i": 1361,
   "src": "6b846e1ee1c9",
