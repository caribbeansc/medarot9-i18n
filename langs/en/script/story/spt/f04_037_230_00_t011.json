{
 "file": "story/spt/f04_037_230_00_t011.spt",
 "lines": [
  {
   "i": 1148,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1156,
   "src": "1ed58f8f5b9e",
   "t": "Hey."
  },
  {
   "i": 1164,
   "src": "48ae10bb17af",
   "t": "We met outside the island too, right?"
  },
  {
   "i": 1167,
   "src": "e52aa4af7961",
   "t": "You know, before I came here--"
  },
  {
   "i": 1182,
   "src": "171bf3b227af",
   "t": "In the town where I used to live."
  },
  {
   "i": 1190,
   "src": "2b33ceef6e9e",
   "t": "You were chasing some weirdos back\nthen, right?"
  },
  {
   "i": 1193,
   "src": "dcf6a981bfc5",
   "t": "Men in black--no, creepy guys in full\nblack tights."
  },
  {
   "i": 1212,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1220,
   "src": "f96198d55e28",
   "t": "So who were those guys, in the end?"
  },
  {
   "i": 1223,
   "src": "171819e00380",
   "t": "They weren't just plain perverts, were\nthey?"
  },
  {
   "i": 1238,
   "src": "34b3537253ab",
   "t": "...No, never mind that."
  },
  {
   "i": 1241,
   "src": "080c7dd38f3d",
   "t": "What matters is that you--"
  },
  {
   "i": 1260,
   "src": "8e84792b07e1",
   "t": "Shut up."
  },
  {
   "i": 1268,
   "src": "ad3cb5700c50",
   "t": "Huh?"
  },
  {
   "i": 1292,
   "src": "f5de2eeba040",
   "t": "You..."
  },
  {
   "i": 1298,
   "src": "516c50d402f7",
   "t": "You..."
  },
  {
   "i": 1315,
   "src": "dc6f448bd06a",
   "t": "You've been noisy this whole time."
  },
  {
   "i": 1336,
   "src": "591d0f7f1831",
   "t": "What exactly do you want?"
  },
  {
   "i": 1342,
   "src": "6a31ed16d073",
   "t": "What exactly is your goal?"
  },
  {
   "i": 1351,
   "src": "95039396e47f",
   "t": "Ah..."
  },
  {
   "i": 1366,
   "src": "6eca3da80745",
   "t": "You finally talked to me."
  },
  {
   "i": 1369,
   "src": "a886d47404ff",
   "t": "Good, I thought you couldn't speak."
  },
  {
   "i": 1388,
   "src": "027167a1a749",
   "t": "Get lost."
  },
  {
   "i": 1396,
   "src": "1db077c79826",
   "t": "Don't say that. Let's talk for a bit."
  },
  {
   "i": 1399,
   "src": "48682043363c",
   "t": "I have tons of questions for you."
  },
  {
   "i": 1407,
   "src": "31e754be8984",
   "t": "Oh, right."
  },
  {
   "i": 1410,
   "src": "bb17880c1925",
   "t": "Before that..."
  },
  {
   "i": 1418,
   "src": "05741c2f4b36",
   "t": "What's your name?"
  },
  {
   "i": 1437,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1445,
   "src": "17ff7dfd21bf",
   "t": "You don't want to keep being called\n\"you,\" right?"
  },
  {
   "i": 1448,
   "src": "68cfed3e1f39",
   "t": "So tell me your name."
  },
  {
   "i": 1463,
   "src": "ba3a1e0d1852",
   "t": "Oh, and I'm "
  },
  {
   "i": 1465,
   "src": "3a56fd31ee59",
   "t": "!"
  },
  {
   "i": 1468,
   "src": "d41c7974cb02",
   "t": "And you? What should I call you?"
  },
  {
   "i": 1491,
   "src": "cdab3fc0be1a",
   "t": "I'm {{metabee}}."
  },
  {
   "i": 1497,
   "src": "f355777cebf3",
   "t": "I am {{rokusho}}."
  },
  {
   "i": 1520,
   "src": "608e43e02722",
   "t": "Wha--!?"
  }
 ]
}
