{
 "file": "story/spt/free06_01_02_04_t021.spt",
 "lines": [
  {
   "i": 1034,
   "src": "c80a5ba2f4a4",
   "t": "So this is the {{shaft_tower}}..."
  },
  {
   "i": 1039,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1045,
   "src": "bae4774482ac",
   "t": "In other words, there's a tunnel\nright beneath here."
  },
  {
   "i": 1052,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1058,
   "src": "aa1953d80b7e",
   "t": "Yeah."
  },
  {
   "i": 1061,
   "src": "4249f838efa2",
   "t": "The elevator is dead, though."
  },
  {
   "i": 1069,
   "src": "de60fc551bb3",
   "t": "Be careful, you'll fall if you try to peek\nin."
  },
  {
   "i": 1072,
   "src": "cda23e6fab81",
   "t": "The bottom is incredibly deep."
  },
  {
   "i": 1079,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1088,
   "src": "7dbec7f4eb72",
   "t": "Be careful, he says..."
  },
  {
   "i": 1096,
   "src": "34d4323f309c",
   "t": "The hole is inside that drum-can-like\ncylinder, right?"
  },
  {
   "i": 1099,
   "src": "66456c165789",
   "t": "I don't see any peephole anywhere."
  },
  {
   "i": 1110,
   "src": "f20b3fa7ddd3",
   "t": "There are stairs."
  },
  {
   "i": 1113,
   "src": "c216a2d5fc27",
   "t": "Couldn't you climb them to the top and\npeek in?"
  },
  {
   "i": 1118,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1127,
   "src": "d00a486e68e4",
   "t": "Those stairs are wrecked, aren't they?"
  },
  {
   "i": 1130,
   "src": "26081a844a87",
   "t": "There are barely any steps left."
  },
  {
   "i": 1141,
   "src": "cfb84575aa84",
   "t": "Oh, right."
  },
  {
   "i": 1144,
   "src": "3b46610bf6a7",
   "t": "Well then, hmm..."
  },
  {
   "i": 1149,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1155,
   "src": "99a96658ed0e",
   "t": "No, no, you guys,"
  },
  {
   "i": 1158,
   "src": "eb7e29291dd7",
   "t": "you don't have to push it and fall in."
  },
  {
   "i": 1165,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1171,
   "src": "8dc1b145e014",
   "t": "Still, to pick up underground sounds,\nright above the hole is best."
  },
  {
   "i": 1174,
   "src": "a662dc916924",
   "t": "For that, we still have to get up the\ntower."
  },
  {
   "i": 1181,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1187,
   "src": "428afdf9aa38",
   "t": "Right, well then..."
  },
  {
   "i": 1191,
   "src": "0bd99c71f0ed",
   "t": "-chan."
  },
  {
   "i": 1204,
   "src": "7292df59b095",
   "t": "Leave it to me."
  }
 ]
}
