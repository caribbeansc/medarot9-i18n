{
 "file": "story/spt/f06_070_161_00_t031.spt",
 "lines": [
  {
   "i": 1036,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1047,
   "src": "71cecb31a684",
   "t": "Hold on to this for a while."
  },
  {
   "i": 1057,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1066,
   "src": "f6d0b1fb28ed",
   "t": "What's that?"
  },
  {
   "i": 1073,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1082,
   "src": "4b6eb61ba9b1",
   "t": "Fireworks."
  },
  {
   "i": 1090,
   "src": "3e2251329bde",
   "t": "It's been decided that the Council will\nhost"
  },
  {
   "i": 1093,
   "src": "2608b0c736a5",
   "t": "a fireworks festival on the last day of\nsummer vacation."
  },
  {
   "i": 1100,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1109,
   "src": "dacc07e1da2c",
   "t": "Oh ho, that sounds fun."
  },
  {
   "i": 1112,
   "src": "0771bf83a36c",
   "t": "But why would you leave the fireworks\nhere?"
  },
  {
   "i": 1119,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1128,
   "src": "84b013b5ad62",
   "t": "I don't want explosives in an unattended\nstoreroom."
  },
  {
   "i": 1131,
   "src": "eac130480a12",
   "t": "And this place is needlessly big. That's\nthe reason."
  },
  {
   "i": 1145,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1154,
   "src": "3820fd06dda9",
   "t": "I see."
  },
  {
   "i": 1161,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1170,
   "src": "9ea6be238233",
   "t": "While you're at it, do me\none more favor."
  },
  {
   "i": 1184,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1193,
   "src": "11ae20c1f79f",
   "t": "What would that be?"
  },
  {
   "i": 1200,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1209,
   "src": "deceae1ad2be",
   "t": "We want you to clear the stray\nMedabots"
  },
  {
   "i": 1212,
   "src": "577483d055d2",
   "t": "from the beach where the event will be\nheld."
  },
  {
   "i": 1220,
   "src": "89e76963c75a",
   "t": "It'd be a shame if the fireworks festival"
  },
  {
   "i": 1223,
   "src": "ff0bac4c97fa",
   "t": "turned into a Robattle tournament."
  },
  {
   "i": 1230,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1239,
   "src": "c7991dc62393",
   "t": "Well, that's fair enough, but"
  },
  {
   "i": 1242,
   "src": "c54a3e166b60",
   "t": "why do we have to do it?"
  },
  {
   "i": 1249,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1258,
   "src": "aee635926ebd",
   "t": "You're free anyway, aren't you?"
  },
  {
   "i": 1272,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1281,
   "src": "e356da9ec2c6",
   "t": "I see."
  },
  {
   "i": 1288,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1297,
   "src": "9ae3feb4988f",
   "t": "Then I'm counting on you."
  },
  {
   "i": 1300,
   "src": "5aed8bfacd28",
   "t": "I'm heading back."
  }
 ]
}
