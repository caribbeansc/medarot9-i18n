   "t": "{{hiroki}}"
  },
  {
   "i": 1156,
   "src": "4711f8147c92",
   "t": "Oh, sorry, um..."
  },
  {
   "i": 1159,
   "src": "7579eb855552",
   "t": "It's a {{medafighter}}'s own ability level."
