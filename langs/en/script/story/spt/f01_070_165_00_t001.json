{
 "file": "story/spt/f01_070_165_00_t001.spt",
 "lines": [
  {
   "i": 1131,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1142,
   "src": "646550b2e55a",
   "t": "97!"
  },
  {
   "i": 1145,
   "src": "8c6e7afc67cb",
   "t": "98!"
  },
  {
   "i": 1153,
   "src": "0ae82381ace0",
   "t": "Ninety... nine!"
  },
  {
   "i": 1156,
   "src": "f81e19f0bc0e",
   "t": "One hun..."
  },
  {
   "i": 1171,
   "src": "d2c54b79eec9",
   "t": "...dred!!!"
  },
  {
   "i": 1179,
   "src": "7b08d6cf3c15",
   "t": "Huff... Haah..."
  },
  {
   "i": 1200,
   "src": "fed537c5ae87",
   "t": "Huh?"
  },
  {
   "i": 1208,
   "src": "61072d928e38",
   "t": "What's with you?"
  },
  {
   "i": 1216,
   "src": "f24ff9fdfc32",
   "t": "Don't tell me..."
  },
  {
   "i": 1231,
   "src": "3510e156a941",
   "t": "You're thinking of joining us?"
  },
  {
   "i": 1234,
   "src": "40321be80a35",
   "t": "Without knowing your place?"
  },
  {
   "i": 1242,
   "src": "5af16e5be7ba",
   "t": "I-I never said I'd join."
  },
  {
   "i": 1245,
   "src": "a0780377ebb8",
   "t": "I just came to take a look!"
  },
  {
   "i": 1250,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1256,
   "src": "9254706bd528",
   "t": "Oh, just looking, huh?"
  },
  {
   "i": 1259,
   "src": "799cf1f8e4db",
   "t": "Then let me explain."
  },
  {
   "i": 1267,
   "src": "28637ca35c90",
   "t": "This {{rescue_club}} is"
  },
  {
   "i": 1270,
   "src": "95451880ec49",
   "t": "the star club of MEDA {{academy}}."
  },
  {
   "i": 1278,
   "src": "9063672e8be4",
   "t": "After all, at last year's National Rescue\nSkills Tournament"
  },
  {
   "i": 1281,
   "src": "6d155ea144f1",
   "t": "we won on our very first try."
  },
  {
   "i": 1289,
   "src": "da4030b4b733",
   "t": "You need good judgment and reflexes,\nand your {{robattle|pl}}"
  },
  {
   "i": 1292,
   "src": "529f34147e02",
   "t": "have to be top class too, or you won't\nlast."
  },
  {
   "i": 1300,
   "src": "3d209bf8df1e",
   "t": "Our president even made the finals"
  },
  {
   "i": 1303,
   "src": "6c4c742c9a32",
   "t": "of last year's World Robattle, against\nadults."
  },
  {
   "i": 1318,
   "src": "96afc6e99f4c",
   "t": "This isn't a {{club}} for the likes of you."
  },
  {
   "i": 1321,
   "src": "471bad40e937",
   "t": "Get lost."
  },
  {
   "i": 1329,
   "src": "d9c1d8c1b8f7",
   "t": "Hmph."
  },
  {
   "i": 1337,
   "src": "9204627eda57",
   "t": "Anyone can come look, right?"
  },
  {
   "i": 1340,
   "src": "0416c2f71c86",
   "t": "Why do I have to put up with this?"
  },
  {
   "i": 1352,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1358,
   "src": "f2ea6d328272",
   "t": "You really don't get it, do you?"
  },
  {
   "i": 1366,
   "src": "1e3c92473f59",
   "t": "I'm saying you're not worth my time!"
  },
  {
   "i": 1369,
   "src": "2e43fc8be0e2",
   "t": "Don't make me say it."
  },
  {
   "i": 1377,
   "src": "0109b264e432",
   "t": "What did you say~!"
  },
  {
   "i": 1395,
   "src": "8dcfe0e46aa0",
   "t": "That's enough."
  },
  {
   "i": 1409,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1420,
   "src": "18bce3b5a77d",
   "t": "A... Einbecker-san!"
  },
  {
   "i": 1423,
   "src": "0de6286c7572",
   "t": "Afternoon!!"
  }
 ]
}
