  {
   "i": 1276,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1281,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1287,
   "src": "2261d2fd21a2",
   "t": "The {{principal|cap}} was determined to keep"
  },
  {
   "i": 1290,
   "src": "5de573f63994",
   "t": "people away from that {{medalium}} at all\ncosts."
