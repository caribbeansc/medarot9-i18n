   "t": "{{principal}}"
  },
  {
   "i": 1149,
   "src": "c43e06003048",
   "t": "Wrong."
  },
  {
   "i": 1156,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1162,
   "src": "cadf1eca18c1",
   "t": "Huh."
  },
  {
   "i": 1178,
   "src": "f71322c5c57d",
   "t": "{{principal}}"
  },
  {
   "i": 1184,
   "src": "76b4f901db62",
   "t": "The {{medalia}} aren't emitting the waves."
  },
  {
   "i": 1187,
   "src": "d4464acb2d4d",
   "t": "That monster-- the {{medal_eater}}-- is."
  },
  {
   "i": 1195,
   "src": "3fd1fb0b4e10",
   "t": "Even while sealed in the {{medalium}},"
