   "t": "{{mr_izumo}}"
  },
  {
   "i": 1035,
   "src": "7b659d5c5b6a",
   "t": "Ah, maidens' youth, all for the festival!"
  },
  {
   "i": 1038,
   "src": "27e1afe5405b",
   "t": "Splendid, splendid, cock-a-doodle-doo!"
  },
  {
   "i": 1049,
   "src": "30b8b209a771",
   "t": "Hm, who are you? We're in the middle"
  },
  {
   "i": 1052,
   "src": "639228cbe62b",
   "t": "of rehearsal, don't get in the way."
  },
  {
   "i": 1060,
   "src": "709f9792707e",
   "t": "Huh, me? Of course it's fine! I'll have"
  },
  {
   "i": 1063,
   "src": "97ef13ce1602",
   "t": "you know I'm the {{idol_club}}'s advisor."
  },
  {
   "i": 1071,
   "src": "6e5e6feb6300",
   "t": "Well, mostly in name only. After all,"
  },
  {
   "i": 1074,
   "src": "4ea5a97d0a49",
   "t": "their {{clubroom}} is off-limits to boys."
  },
  {
   "i": 1082,
   "src": "b54deb64ec4c",
   "t": "Ha ha ha ha ha ha ha."
  }
 ]
