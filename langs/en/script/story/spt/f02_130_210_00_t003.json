   "t": "{{ryoma}}"
  },
  {
   "i": 1045,
   "src": "b38c819f72fc",
   "t": "Wait."
  },
  {
   "i": 1056,
   "src": "92cb6d28f4ae",
   "t": "What's with that boat?"
  },
  {
   "i": 1066,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1072,
   "src": "ae06e08d4f18",
   "t": "Oh, haven't I told you yet?"
  },
  {
   "i": 1075,
   "src": "9efd412bd7cb",
   "t": "We were stuck, unable to go any farther."
  },
  {
   "i": 1083,
   "src": "c94223f3315e",
   "t": "A {{classmate}}'s {{medabot}}"
  },
  {
   "i": 1086,
   "src": "0426f1c55c89",
   "t": "just fell from here."
  },
  {
   "i": 1094,
   "src": "32fb1f8bf847",
   "t": "I want to go help, but I lack the guts"
  },
  {
   "i": 1097,
   "src": "5234e8b138e7",
   "t": "to jump into these rapids in a boat with\nno oars..."
  },
  {
   "i": 1102,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1108,
   "src": "26f3a695c8ab",
   "t": "I see."
  },
  {
   "i": 1116,
   "src": "9635b6e12bcd",
   "t": "Got it. I'll take you there."
  },
  {
   "i": 1119,
   "src": "dd5005810897",
   "t": "But I can't guarantee your safety."
  },
  {
   "i": 1133,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1139,
   "src": "d82c9196d199",
   "t": "Well, we'll cross that bridge when we\ncome to it."
  },
  {
   "i": 1142,
   "src": "ea3bdeb699ba",
   "t": "I'm sure it'll work out, ahaha."
  },
  {
   "i": 1149,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1155,
   "src": "dcd48e30b2f3",
   "t": "As carefree as ever."
  },
  {
   "i": 1158,
   "src": "0ab41ec6098c",
   "t": "...Oh well."
  }
