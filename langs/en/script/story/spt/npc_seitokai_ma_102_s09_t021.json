  {
   "i": 1027,
   "src": "b9a21fb07ca6",
   "t": "{{council_hyoga}}"
  },
  {
   "i": 1038,
   "src": "36f2a4bdbca7",
   "t": "Sorry, sorry, I think you've already\nheard, but..."
  },
  {
   "i": 1046,
   "src": "e04b792a4d34",
   "t": "Here, from the {{janitor}}."
  },
  {
   "i": 1049,
   "src": "bc76523bfa1a",
   "t": "Has it arrived already?"
  },
  {
   "i": 1054,
   "src": "b9a21fb07ca6",
   "t": "{{council_hyoga}}"
  },
  {
   "i": 1060,
   "src": "d8dbffd7aabb",
   "t": "Yeah, just a moment ago."
  },
  {
   "i": 1063,
   "src": "5048fbe1cd3a",
   "t": "Sorry for making you go all that way for\nnothing."
  },
  {
