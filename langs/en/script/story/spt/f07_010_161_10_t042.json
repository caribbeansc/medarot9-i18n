  },
  {
   "i": 1155,
   "src": "ddcf0ae44096",
   "t": "Oh, right."
  },
  {
   "i": 1163,
   "src": "f5936155f16a",
   "t": "I almost forgot to mention it."
  },
  {
   "i": 1166,
   "src": "4e7c247bd895",
   "t": "I have a proposal."
  },
  {
   "i": 1173,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1179,
