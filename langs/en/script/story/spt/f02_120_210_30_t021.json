  },
  {
   "i": 1068,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1074,
   "src": "6447006caffb",
   "t": "Mmm~."
  },
  {
   "i": 1082,
   "src": "022630373616",
   "t": "W-what is it, President? Don't tell me I"
