   "t": "{{crater}}?!"
  },
  {
   "i": 1058,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1064,
   "src": "ddcf0ae44096",
   "t": "That's right. It's a landform created"
  },
  {
   "i": 1067,
