   "t": "{{principal|cap}}"
  },
  {
   "i": 1042,
   "src": "7b629660cef2",
   "t": "Suruga?"
  },
  {
   "i": 1045,
   "src": "0b7e24363d72",
   "t": "Why are you here..."
  },
  {
   "i": 1052,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1058,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1073,
   "src": "74b7a3614c9d",
   "t": "I still don't understand"
  },
  {
   "i": 1076,
   "src": "240c5d7eb011",
   "t": "what it is you're trying to do."
  },
  {
   "i": 1084,
   "src": "117de321fa41",
   "t": "But"
  },
  {
   "i": 1092,
   "src": "4f8810c430b8",
   "t": "for this moment,"
  },
  {
   "i": 1095,
   "src": "183edd19d561",
   "t": "you've been fighting alone, haven't you?"
  },
  {
   "i": 1103,
   "src": "4a46eecc98f9",
   "t": "To settle this situation,"
  },
  {
   "i": 1106,
   "src": "9f10c6873d95",
   "t": "that's the only way, isn't it?"
  },
  {
   "i": 1114,
   "src": "2156662d00ed",
   "t": "If that is your way,"
  },
  {
   "i": 1117,
   "src": "6707c3b0d528",
   "t": "then I will also--"
  },
  {
   "i": 1132,
   "src": "7547472a1fa0",
   "t": "I'll hold to my own way."
  },
  {
   "i": 1139,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1145,
   "src": "b200c2e91c6b",
   "t": "Your way, you say...?"
  },
  {
   "i": 1152,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1158,
   "src": "c702dfeb28e9",
   "t": "All I can do is obey orders."
  },
  {
   "i": 1161,
   "src": "2d11008c5b9c",
   "t": "I know no other way to live."
  },
  {
   "i": 1169,
   "src": "1b3a05a99057",
   "t": "If I trust the one giving them, gladly;"
  },
  {
   "i": 1172,
   "src": "cf21c0a23386",
   "t": "if I don't, I carry them out all the same."
  },
  {
   "i": 1180,
   "src": "48c295947f69",
   "t": "So please, give me orders."
  },
  {
   "i": 1183,
   "src": "66a8699a962a",
   "t": "This time I'll carry them out flawlessly!"
  },
  {
   "i": 1198,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1206,
   "src": "eac1e48997a0",
   "t": "Hmph."
  },
  {
   "i": 1209,
   "src": "574d44eab2a5",
   "t": "You're as strange as ever."
  },
  {
   "i": 1217,
   "src": "09783e54c76d",
   "t": "Very well, I'll order you as you wish."
  },
  {
   "i": 1220,
   "src": "ba57815da499",
   "t": "Stop that monster."
  },
  {
   "i": 1227,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1233,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1246,
   "src": "6c1708a9ea10",
   "t": "Leave it to me, {{principal|cap}}!"
  },
  {
   "i": 1253,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1259,
   "src": "f43964cfc4bc",
   "t": "Listen, even if you defeat it, it revives\nright away."
  },
  {
   "i": 1262,
   "src": "a77df167eb7b",
   "t": "Stalling it is enough."
  },
  {
   "i": 1274,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1280,
   "src": "342c20413c8f",
   "t": "Yes!"
  },
  {
   "i": 1287,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1293,
   "src": "2fbb76c66ea1",
   "t": "Don't overdo it--... no,"
  },
  {
   "i": 1307,
   "src": "55af011d6889",
   "t": "Vice-Principal"
  },
  {
   "i": 1313,
   "src": "dba55262eead",
   "t": "Here it comes!"
  },
  {
   "i": 1316,
   "src": "7fedff8b03eb",
   "t": "Please go!"
  },
  {
   "i": 1330,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1336,
   "src": "348404ffa2fa",
   "t": "I'm counting on you."
  }
 ]
