 "file": "battle/spt/auto_battle11.spt",
 "lines": [
  {
   "i": 881,
   "src": "cd5a0c53a167",
   "t": "Ladrón Jill"
  },
  {
   "i": 887,
   "src": "225bb0e4dfb9",
   "t": "{{anise}}"
  },
  {
   "i": 890,
   "src": "6b409ccd4db4",
   "t": "{{sage}}"
  },
  {
   "i": 893,
   "src": "3bb7ece2adab",
   "t": "{{laurel}}"
  },
  {
   "i": 896,
   "src": "3c7edee2c1de",
   "t": "{{asad_arak}}"
  },
  {
   "i": 1130,
   "src": "61d382b0d43a",
   "t": "¿Qué pasa?\nSolo defendiéndote no vas a ganar."
  },
  {
   "i": 1198,
   "src": "b92be2ec490e",
   "t": "\"Sus ataques no alcanzan mi cuerpo.\"\n¿Verdad? Eso fue lo que dijiste."
  },
  {
   "i": 1209,
   "src": "edee419b7467",
   "t": "Bloqueaste todo tipo de ataque\ncon esa aura negra, pero..."
  },
  {
   "i": 1214,
   "src": "e023bba5b141",
   "t": "Nunca imaginaste que tu {{self}}\nataque sería bloqueado, ¿verdad?"
  },
  {
   "i": 1241,
   "src": "28ebb89208de",
   "t": "¿Y eso qué?"
  },
  {
   "i": 1274,
   "src": "1e8a61811d59",
   "t": "Úsala, vamos.\n¡Tu verdadera medafuerza!"
  },
  {
   "i": 1353,
   "src": "bf478669310e",
   "t": "¡No subestimes mi poder,\nhumano insolente!"
  },
  {
   "i": 1586,
   "src": "e0e7a9c631fc",
   "t": "¡Ggh, tanto poder...!"
  },
  {
   "i": 1630,
   "src": "14d337d8c62e",
   "t": "¡Aaaahhh...!"
  },
  {
   "i": 1690,
   "src": "0b06aec44d38",
   "t": "¡Aah!\n¡La máscara del ladrón Gil!"
  },
  {
   "i": 1720,
   "src": "fe46cca64783",
   "t": "¿...eh?"
  },
  {
   "i": 1747,
   "src": "b700b5f68384",
   "t": "¿¡La identidad del ladrón Gil es Marie!?"
  },
  {
   "i": 1774,
   "src": "ca3b84315756",
   "t": "...!"
  },
  {
   "i": 1916,
   "src": "d734851106a5",
   "t": "¡Aún sigues en pie...\nMe estorbas!"
  },
  {
   "i": 1946,
   "src": "b09a6042816f",
   "t": "¡Ahora esto sí servirá...!"
  },
  {
   "i": 2000,
   "src": "1337806c4951",
   "t": "¡Qué astuto!"
  },
  {
   "i": 2125,
   "src": "39045524d4f6",
   "t": "Parece que es mi límite..."
  }
 ]
}
