  },
  {
   "i": 1108,
   "src": "abd28222a226",
   "t": "Calma, calma, {{mio}}-kun, tranquilízate."
  },
  {
   "i": 1111,
   "src": "306658d6200c",
   "t": "Más importante, a ver, este..."
  },
  {
   "i": 1122,
   "src": "9868dfe05bd8",
   "t": "Tú eres {{main}}-chan, ¿verdad?"
  },
  {
   "i": 1139,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1148,
   "src": "4fdb21beed09",
   "t": "Sí, soy {{main}}. Tú eres el presidente"
  },
  {
   "i": 1151,
   "src": "00edd2bd7858",
   "t": "del {{exploration_club}}, ¿no?"
