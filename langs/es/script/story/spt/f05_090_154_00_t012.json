   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1199,
   "src": "cbd56345b8e5",
   "t": "¿Segunda ronda? ¿Contra quién fue?"
  },
  {
   "i": 1202,
   "src": "62f0ddd2b252",
   "t": "Ah... el Club Medabot, ya veo."
  },
  {
   "i": 1209,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1218,
   "src": "29ea8facacf3",
   "t": "¿Por qué viniste aquí?"
  },
  {
   "i": 1221,
   "src": "040d1cfc29ce",
   "t": "¿Notaste las {{part|pl}} que faltan?"
  },
  {
   "i": 1235,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1244,
   "src": "d380e91a0a50",
   "t": "Correcto."
  },
  {
   "i": 1251,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1260,
   "src": "a178faed932c",
   "t": "Solo las tomé prestadas un momento."
  },
  {
   "i": 1263,
   "src": "75b6209b6b63",
   "t": "Las devolveré pronto."
  },
  {
   "i": 1270,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1279,
   "src": "c859d70fac92",
   "t": "¿Por qué hiciste algo así?"
