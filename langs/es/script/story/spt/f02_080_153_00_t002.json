  },
  {
   "i": 1160,
   "src": "b8b4d1d94eaa",
   "t": "¿Qué hacemos?"
  },
  {
   "i": 1165,
   "src": "c91be7c5a726",
   "t": "Primero deberíamos avisarle a la\nceladora--"
