 "lines": [
  {
   "i": 1039,
   "src": "fc4e6d8c9853",
   "t": "Cuando dices '{{water_mill}}'..."
  },
  {
   "i": 1044,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1050,
   "src": "482bd994f680",
   "t": "Está más allá del {{misty_deep_forest}},"
  },
  {
   "i": 1053,
   "src": "a08eaacdc2dc",
   "t": "subiendo por el arroyo. ¿Vamos?"
  },
  {
   "i": 1067,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1076,
   "src": "ca2959b3638f",
   "t": "¡Voy!"
  },
  {
   "i": 1087,
   "src": "318bc506addc",
   "t": "Ah, pero..."
  },
  {
   "i": 1097,
   "src": "cf6220e985aa",
   "t": "Cuando arreglen la pierna de {{flora}},"
  },
  {
   "i": 1100,
   "src": "f097a57e174c",
   "t": "{{mio}} ya no podrá bailar."
  },
  {
   "i": 1108,
   "src": "4962b80b8496",
   "t": "Se va a decepcionar mucho."
  },
  {
   "i": 1111,
   "src": "961934f19f61",
   "t": "{{mio}}."
  },
  {
   "i": 1116,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1122,
   "src": "878827e75e4f",
   "t": "Los decepcionados serán los miembros"
  },
  {
   "i": 1125,
   "src": "bf0b4570053a",
   "t": "del {{idol_club}} que ya no pueden bailar."
  },
  {
   "i": 1140,
   "src": "ca454d4a9b8b",
   "t": "{{mio}} ya es miembro de nuestro {{club}}."
  },
  {
   "i": 1143,
   "src": "356db2120d20",
   "t": "No podemos pasarla sin ella en el {{club}}."
  },
  {
   "i": 1151,
   "src": "187d6ff29116",
   "t": "¿...Eh?"
  },
  {
   "i": 1159,
   "src": "48c79a6f291d",
   "t": "N-no, vamos, eso es obvio."
  },
  {
   "i": 1162,
   "src": "8db0d71a79b2",
   "t": "Es solo durante el {{culture_festival}}."
  },
  {
   "i": 1170,
   "src": "4b16a6426262",
   "t": "Cuando termine el festival, claro que\nvolverá--"
  },
  {
   "i": 1178,
   "src": "cafab9a32435",
   "t": "Volverá..."
  },
  {
   "i": 1196,
   "src": "15ec532e1ae4",
   "t": "Volverá, ¿verdad?"
  },
  {
   "i": 1201,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1207,
   "src": "b19cdb4bbad6",
   "t": "No me preguntes a mí."
  },
  {
