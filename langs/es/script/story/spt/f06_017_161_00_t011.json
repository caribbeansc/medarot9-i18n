   "t": "..."
  },
  {
   "i": 1054,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1065,
   "src": "20287d76f44f",
   "t": "Es un sintetizador de {{medalia|pl}}."
  },
  {
   "i": 1079,
   "src": "fed537c5ae87",
   "t": "¿Eh?"
  },
  {
   "i": 1092,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1103,
   "src": "2b02e47fe036",
   "t": "La {{medalia}}, antes una sola masa,"
  },
  {
   "i": 1106,
   "src": "c7009eb7f9c5",
   "t": "se sintetiza con relativa facilidad."
  },
  {
   "i": 1114,
   "src": "d9e5e6fce154",
   "t": "Los rasgos ambientales se anulaban"
  },
  {
   "i": 1117,
   "src": "1a7912d2f9e0",
   "t": "y estorbaban su uso práctico."
  },
  {
   "i": 1132,
   "src": "466e51bd80ab",
   "t": "Por fin hallamos el principio"
  },
  {
   "i": 1135,
   "src": "c843da8c497a",
   "t": "y lo hicimos usable. Aquí está."
  },
  {
   "i": 1146,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1166,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1177,
   "src": "2c17c424ec9d",
   "t": "Está bien. Aunque lo hagas"
  },
  {
   "i": 1180,
   "src": "52810d263483",
   "t": "al azar, igual te harás más fuerte."
  },
  {
   "i": 1188,
   "src": "2a8589fe5a63",
   "t": "El {{level}} total de la {{medalia}} sintetizada"
  },
  {
   "i": 1191,
   "src": "89785197d75a",
   "t": "pasa a ser el {{level}} de la {{medalia}} base."
  },
  {
   "i": 1199,
   "src": "9c162928c848",
   "t": "Si ves que acumulas {{medalia|pl}} sin"
  },
  {
   "i": 1202,
   "src": "feb3296f05de",
   "t": "usar, entonces dale una oportunidad."
  },
  {
   "i": 1213,
   "src": "b7d965cee4b1",
   "t": "Vaya... Gracias,"
  },
  {
   "i": 1216,
   "src": "1b1bea580ab4",
   "t": "{{main}}-chan. Lo voy a probar."
  },
  {
   "i": 1228,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1237,
   "src": "052f7bf28a4e",
   "t": "¡¡¡Ah!!!"
  },
  {
   "i": 1255,
   "src": "19ec58bf1185",
   "t": "¡Guau!"
  },
  {
   "i": 1263,
   "src": "cd68f1c5b224",
   "t": "¡¿Q-qué pasa?!"
  },
  {
   "i": 1268,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1277,
   "src": "31725c9efcb3",
   "t": "Olvidé mencionar una cosa."
  },
  {
   "i": 1280,
   "src": "03dd2444083b",
   "t": "Solo ten cuidado con esto."
  },
  {
   "i": 1291,
   "src": "fed537c5ae87",
   "t": "¿Qué cosa?"
  },
  {
   "i": 1296,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1305,
   "src": "c670c0925c74",
   "t": "La {{medalia}} sintetizada desaparecerá."
  },
  {
   "i": 1308,
   "src": "c6765b069a90",
   "t": "Las habilidades también se perderán."
  },
  {
   "i": 1323,
   "src": "70732d5eb987",
   "t": "Asegúrate de usar la {{medalia}}"
  },
  {
   "i": 1326,
   "src": "db3e167a7b93",
   "t": "importante como base. ¡¿Lo prometes?!"
  },
  {
   "i": 1344,
   "src": "5e5d9de9a2cb",
   "t": "Está bien, entendido..."
  },
  {
   "i": 1347,
   "src": "ecb9683cddba",
   "t": "Gracias."
  }
 ]
}
