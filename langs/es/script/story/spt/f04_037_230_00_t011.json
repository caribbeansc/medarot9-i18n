{
 "file": "story/spt/f04_037_230_00_t011.spt",
 "lines": [
  {
   "i": 1148,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1156,
   "src": "1ed58f8f5b9e",
   "t": "Oye."
  },
  {
   "i": 1164,
   "src": "48ae10bb17af",
   "t": "Ya nos vimos fuera de la isla, ¿no?"
  },
  {
   "i": 1167,
   "src": "e52aa4af7961",
   "t": "Sabes, antes de venir aquí--"
  },
  {
   "i": 1182,
   "src": "171bf3b227af",
   "t": "En el pueblo donde yo vivía."
  },
  {
   "i": 1190,
   "src": "2b33ceef6e9e",
   "t": "Perseguías a unos raros, ¿no?"
  },
  {
   "i": 1193,
   "src": "dcf6a981bfc5",
   "t": "Tipos en mallas negras, sospechosos."
  },
  {
   "i": 1212,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1220,
   "src": "f96198d55e28",
   "t": "Entonces, ¿quiénes eran esos al final?"
  },
  {
   "i": 1223,
   "src": "171819e00380",
   "t": "No eran solo unos pervertidos, ¿verdad?"
  },
  {
   "i": 1238,
   "src": "34b3537253ab",
   "t": "...No, eso no importa."
  },
  {
   "i": 1241,
   "src": "080c7dd38f3d",
   "t": "Lo importante es que tú--"
  },
  {
   "i": 1260,
   "src": "8e84792b07e1",
   "t": "Cállate."
  },
  {
   "i": 1268,
   "src": "ad3cb5700c50",
   "t": "¿Eh?"
  },
  {
   "i": 1292,
   "src": "f5de2eeba040",
   "t": "Tú..."
  },
  {
   "i": 1298,
   "src": "516c50d402f7",
   "t": "Maldito..."
  },
  {
   "i": 1315,
   "src": "dc6f448bd06a",
   "t": "Llevas un buen rato haciendo ruido."
  },
  {
   "i": 1336,
   "src": "591d0f7f1831",
   "t": "¿Qué es lo que quieres exactamente?"
  },
  {
   "i": 1342,
   "src": "6a31ed16d073",
   "t": "¿Cuál es exactamente tu objetivo?"
  },
  {
   "i": 1351,
   "src": "95039396e47f",
   "t": "Ah..."
  },
  {
   "i": 1366,
   "src": "6eca3da80745",
   "t": "Por fin me hablaste."
  },
  {
   "i": 1369,
   "src": "a886d47404ff",
   "t": "Qué bueno, creí que no podías hablar."
  },
  {
   "i": 1388,
   "src": "027167a1a749",
   "t": "Lárgate."
  },
  {
   "i": 1396,
   "src": "1db077c79826",
   "t": "No digas eso. Hablemos un rato."
  },
  {
   "i": 1399,
   "src": "48682043363c",
   "t": "Tengo un montón de preguntas para ti."
  },
  {
   "i": 1407,
   "src": "31e754be8984",
   "t": "Ah, cierto."
  },
  {
   "i": 1410,
   "src": "bb17880c1925",
   "t": "Antes de eso..."
  },
  {
   "i": 1418,
   "src": "05741c2f4b36",
   "t": "¿Cómo te llamas?"
  },
  {
   "i": 1437,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1445,
   "src": "17ff7dfd21bf",
   "t": "¿No te molesta seguir siendo solo 'tú'?"
  },
  {
   "i": 1448,
   "src": "68cfed3e1f39",
   "t": "Así que dime tu nombre."
  },
  {
   "i": 1463,
   "src": "ba3a1e0d1852",
   "t": "¡Ah, cierto, yo soy "
  },
  {
   "i": 1465,
   "src": "3a56fd31ee59",
   "t": "!"
  },
  {
   "i": 1468,
   "src": "d41c7974cb02",
   "t": "¿Y tú? ¿Cómo te llamo?"
  },
  {
   "i": 1491,
   "src": "cdab3fc0be1a",
   "t": "{{metabee}}."
  },
  {
   "i": 1497,
   "src": "f355777cebf3",
   "t": "{{rokusho}}."
  },
  {
   "i": 1520,
   "src": "608e43e02722",
   "t": "¿¡Eh!?"
  }
 ]
}
