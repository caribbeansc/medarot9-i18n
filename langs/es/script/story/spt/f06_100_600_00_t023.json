  {
   "i": 1201,
   "src": "9df602b73a33",
   "t": "Sí..."
  },
  {
   "i": 1204,
   "src": "68c6a1e309f8",
   "t": "También estábamos hartos de tantos."
  },
  {
   "i": 1215,
   "src": "8a3fe620da8c",
   "t": "E-está bien, entendido."
  },
  {
   "i": 1218,
   "src": "f446dfe736e0",
