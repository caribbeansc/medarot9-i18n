{
 "file": "story/spt/f05_035_230_10_t024.spt",
 "lines": [
  {
   "i": 1031,
   "src": "5c3f4cc69311",
   "t": "{{hiroki}}"
  },
  {
   "i": 1042,
   "src": "908cedd8cff7",
   "t": "...eso me dijo ella."
  },
  {
   "i": 1057,
   "src": "3c0b13436a2f",
   "t": "Es-eso me suena familiar."
  },
  {
   "i": 1062,
   "src": "5c3f4cc69311",
   "t": "{{hiroki}}"
  },
  {
   "i": 1068,
   "src": "69f0e962bbea",
   "t": "Cuando pregunté dónde estaba"
  },
  {
   "i": 1071,
   "src": "df47f0e385e6",
   "t": "el {{medabot}} más fuerte..."
  },
  {
   "i": 1079,
   "src": "5e7c73f9b40c",
   "t": "¿Te dijo que era aquí?"
  },
  {
   "i": 1091,
   "src": "5c3f4cc69311",
   "t": "{{hiroki}}"
  },
  {
   "i": 1097,
   "src": "5ef32737b957",
   "t": "...Sí."
  },
  {
   "i": 1112,
   "src": "41e9740fa347",
   "t": "Ah, ya veo. Ahora entiendo."
  },
  {
   "i": 1115,
   "src": "f0a43d978ea7",
   "t": "Bueno, no lo entiendo para nada."
  },
  {
   "i": 1123,
   "src": "4225b4732d3a",
   "t": "¿Pero {{saika}}-san recién se transfirió?"
  },
  {
   "i": 1126,
   "src": "ccb4e5d96a02",
   "t": "¿Cómo sabría de este lugar?"
  },
  {
   "i": 1131,
   "src": "5c3f4cc69311",
   "t": "{{hiroki}}"
  },
  {
   "i": 1137,
   "src": "ee7769344082",
   "t": "Bueno... eso no lo sé."
  },
  {
   "i": 1145,
   "src": "6fc36eda927f",
   "t": "Pero al verte pelear, me di cuenta"
  },
  {
   "i": 1148,
   "src": "76c075bc52b3",
   "t": "de que alguien como yo no te gana."
  },
  {
   "i": 1156,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1171,
   "src": "d348b9c561ac",
   "t": "Creo que después de todo me iré a casa."
  },
  {
   "i": 1174,
   "src": "e11e1693b347",
   "t": "Voy a olvidarme de esto por completo."
  },
  {
   "i": 1182,
   "src": "9ba1423edf0d",
   "t": "¡Nos vemos!"
  }
 ]
}
