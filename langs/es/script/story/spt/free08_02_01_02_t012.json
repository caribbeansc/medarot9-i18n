   "t": "{{ryoma}}"
  },
  {
   "i": 1048,
   "src": "6af787e3a837",
   "t": "No me había dado cuenta."
  },
  {
   "i": 1051,
   "src": "7b197b7e22e9",
   "t": "¿Estaba oculto entre la hierba...?"
  },
  {
   "i": 1059,
   "src": "473579d5b380",
   "t": "Ah, ya entiendo. Últimamente todos"
  },
  {
   "i": 1062,
