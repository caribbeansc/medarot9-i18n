  },
  {
   "i": 1171,
   "src": "3e90c9219cc8",
   "t": "Es cierto."
  },
  {
   "i": 1178,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1184,
   "src": "ad2408f632ed",
   "t": "La dirección coincide con la señal de\n{{medalia}}."
  },
  {
