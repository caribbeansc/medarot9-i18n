   "t": "¡97!"
  },
  {
   "i": 1145,
   "src": "8c6e7afc67cb",
   "t": "¡98!"
  },
  {
   "i": 1153,
   "src": "0ae82381ace0",
   "t": "¡Noventa... y nueve!"
  },
  {
   "i": 1156,
   "src": "f81e19f0bc0e",
   "t": "¡¡¡Ci..."
  },
  {
   "i": 1171,
   "src": "d2c54b79eec9",
   "t": "...en!!!"
  },
  {
   "i": 1179,
   "src": "7b08d6cf3c15",
   "t": "Uf... Haa..."
  },
  {
   "i": 1200,
   "src": "fed537c5ae87",
   "t": "¿Eh?"
  },
  {
   "i": 1208,
   "src": "61072d928e38",
   "t": "¿Qué te pasa a ti?"
  },
  {
   "i": 1216,
   "src": "f24ff9fdfc32",
   "t": "No me digas que..."
  },
  {
   "i": 1231,
   "src": "3510e156a941",
   "t": "¿Piensas unirte a nuestro club?"
  },
  {
   "i": 1234,
   "src": "40321be80a35",
   "t": "¿Sin saber cuál es tu lugar?"
  },
  {
   "i": 1242,
   "src": "5af16e5be7ba",
   "t": "N-no dije que me iba a unir."
  },
  {
   "i": 1245,
   "src": "a0780377ebb8",
   "t": "¡Solo vine a echar un vistazo!"
  },
  {
   "i": 1250,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1256,
   "src": "9254706bd528",
   "t": "Ah, solo mirando, ¿eh?"
  },
  {
   "i": 1259,
   "src": "799cf1f8e4db",
   "t": "Pues entonces, te lo voy a explicar."
  },
  {
   "i": 1267,
   "src": "28637ca35c90",
   "t": "El {{rescue_club}}, para que sepas,"
  },
  {
   "i": 1270,
   "src": "95451880ec49",
   "t": "es la estrella de la {{academy|cap}} MEDA."
  },
  {
   "i": 1278,
   "src": "9063672e8be4",
   "t": "En el Campeonato Nacional de Rescate"
  },
  {
   "i": 1281,
   "src": "6d155ea144f1",
   "t": "del año pasado ganamos a la primera."
  },
  {
   "i": 1289,
   "src": "da4030b4b733",
   "t": "Necesitas criterio y reflejos de sobra,"
  },
  {
   "i": 1292,
   "src": "529f34147e02",
   "t": "y robobatallar entre los mejores."
  },
  {
   "i": 1300,
   "src": "3d209bf8df1e",
   "t": "El presidente llegó a la final del Mundial"
  },
  {
   "i": 1303,
   "src": "6c4c742c9a32",
   "t": "de robobatalla, entre adultos."
  },
  {
   "i": 1318,
   "src": "96afc6e99f4c",
   "t": "Este no es {{club}} para alguien como tú."
  },
  {
   "i": 1321,
   "src": "471bad40e937",
   "t": "Lárgate."
  },
  {
   "i": 1329,
   "src": "d9c1d8c1b8f7",
   "t": "Hmph."
  },
  {
   "i": 1337,
   "src": "9204627eda57",
   "t": "Mirar está permitido, ¿no?"
  },
  {
   "i": 1340,
   "src": "0416c2f71c86",
   "t": "¿Por qué tienes que regañarme así?"
  },
  {
   "i": 1352,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1358,
   "src": "f2ea6d328272",
   "t": "Qué tipo más torpe eres."
  },
  {
   "i": 1366,
   "src": "1e3c92473f59",
   "t": "¡Tratar contigo es perder el tiempo!"
  },
  {
   "i": 1369,
   "src": "2e43fc8be0e2",
   "t": "No me hagas repetirlo."
  },
  {
   "i": 1377,
   "src": "0109b264e432",
   "t": "¡¿Qué dijiste?!"
  },
  {
   "i": 1395,
   "src": "8dcfe0e46aa0",
   "t": "Ya basta."
  },
  {
   "i": 1409,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1420,
   "src": "18bce3b5a77d",
   "t": "Ah... ¡Einbecker-san!"
  },
  {
   "i": 1423,
   "src": "0de6286c7572",
   "t": "¡¡Buenas!!"
  }
 ]
