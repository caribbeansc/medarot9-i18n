   "t": "{{vice_principal|cap}}"
  },
  {
   "i": 1035,
   "src": "0bbb4dd3a451",
   "t": "El {{principal}} hizo algo así..."
  },
  {
   "i": 1043,
   "src": "d3cbc7024c91",
   "t": "Bien, intentaré pedirle que les"
  },
  {
   "i": 1046,
   "src": "e9c941f11987",
   "t": "devuelva esos datos tan importantes."
  },
  {
   "i": 1054,
   "src": "3d4f6fbaee77",
   "t": "¡Muchas gracias!"
  },
  {
   "i": 1059,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1065,
   "src": "9b1b66e42322",
   "t": "Lo siento, cuántas molestias le causo."
  },
  {
   "i": 1072,
   "src": "55af011d6889",
   "t": "{{vice_principal|cap}}"
  },
  {
   "i": 1078,
   "src": "82599da1feaa",
   "t": "No importa. Pero los"
  },
  {
   "i": 1081,
   "src": "265522ac8156",
   "t": "descubrieron bastante rápido, ¿no?"
  },
  {
   "i": 1089,
   "src": "d116e974dfd9",
   "t": "Ah, y para que lo sepas,"
  },
  {
   "i": 1092,
   "src": "5592f060c647",
   "t": "yo no dije ni una palabra."
  },
  {
   "i": 1099,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1105,
   "src": "5c7a24a3a5be",
   "t": "Lo entiendo."
  },
  {
   "i": 1112,
   "src": "55af011d6889",
   "t": "{{vice_principal|cap}}"
  },
  {
   "i": 1118,
   "src": "7b994828a134",
   "t": "Sí"
  },
  {
   "i": 1121,
   "src": "4a9a43081103",
   "t": "Entonces denme algo de tiempo."
  },
  {
   "i": 1129,
   "src": "f7ce4f053c2a",
   "t": "Déjenme al {{principal}} a mí."
  },
  {
   "i": 1132,
   "src": "c6c9977a2a55",
   "t": "Disfruten lo que queda del verano."
  }
 ]
