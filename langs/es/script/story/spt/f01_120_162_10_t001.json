  },
  {
   "i": 1196,
   "src": "324cd73c8a23",
   "t": "Era una {{trap}} de disparo. De dejarla,"
  },
  {
   "i": 1199,
   "src": "42d94734160f",
   "t": "todo se nos pondría en contra, ¿no?"
  },
  {
   "i": 1205,
   "src": "213bb58425e1",
   "t": "Era una {{trap}} de combate. De dejarla,"
