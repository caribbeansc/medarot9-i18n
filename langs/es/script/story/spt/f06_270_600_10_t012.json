{
 "file": "story/spt/f06_270_600_10_t012.spt",
 "lines": [
  {
   "i": 1032,
   "src": "a2b1e7832fe2",
   "t": "¿...Eh?"
  },
  {
   "i": 1041,
   "src": "3a56fd31ee59",
   "t": "!"
  },
  {
   "i": 1062,
   "src": "9cb84c5f2af1",
   "t": "¿Qué pasa?"
  },
  {
   "i": 1070,
   "src": "2fe9c93e47d9",
   "t": "¿De dónde sacaste esa sandía?"
  },
  {
   "i": 1089,
   "src": "769c3cf06389",
   "t": "Me la encontré."
  },
  {
   "i": 1097,
   "src": "33a409e8c7a0",
   "t": "¿Te la encontraste?"
  },
  {
   "i": 1104,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1110,
   "src": "9a46100b7961",
   "t": "¡Espera ahí, desgraciado!"
  },
  {
   "i": 1118,
   "src": "54906cb2fbdd",
   "t": "{{ryusei}}..."
  },
  {
   "i": 1125,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1131,
   "src": "4fcc88e92278",
   "t": "Ah, creía haberlo visto antes..."
  },
  {
   "i": 1134,
   "src": "777e740873ee",
   "t": "¡Es ese tu {{medabot}}, "
  },
  {
   "i": 1136,
   "src": "3a56fd31ee59",
   "t": "!"
  },
  {
   "i": 1144,
   "src": "c122540d506e",
   "t": "Usar a tu {{partner}} para robar?"
  },
  {
   "i": 1147,
   "src": "8a66b5793303",
   "t": "¡Eres un pedazo de basura despreciable!"
  },
  {
   "i": 1155,
   "src": "87bf648540bc",
   "t": "¿Robar?"
  },
  {
   "i": 1158,
   "src": "275919942d87",
   "t": "Para nada."
  },
  {
   "i": 1166,
   "src": "7f764ee411ab",
   "t": "Parece que se la llevó por accidente."
  },
  {
   "i": 1169,
   "src": "fd22f4e51e31",
   "t": "Lo siento. Te la devuelvo."
  },
  {
   "i": 1174,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1180,
   "src": "2a502bc0dd7e",
   "t": "¿Cómo que por accidente...?"
  },
  {
   "i": 1188,
   "src": "5a409a15e3fd",
   "t": "No te hagas el tonto."
  },
  {
   "i": 1191,
   "src": "0780efc4536c",
   "t": "¡Tú fuiste quien dio la orden!"
  },
  {
   "i": 1199,
   "src": "60ce9dd5e2e5",
   "t": "¡Yo nunca daría esa orden!"
  },
  {
   "i": 1202,
   "src": "e63617b352f2",
   "t": "Si esa sandía es tan importante,"
  },
  {
   "i": 1210,
   "src": "6fb7c9af7e7b",
   "t": "¿por qué la dejas a la vista de todos?"
  },
  {
   "i": 1213,
   "src": "c7f327a7ebe4",
   "t": "¡Deberías guardarla en una caja fuerte!"
  },
  {
   "i": 1218,
   "src": "7d1cab492889",
   "t": "{{ryusei}}"
  },
  {
   "i": 1224,
   "src": "f1219b5c4b01",
   "t": "Ah, y ahora te pones descarado, ¿eh?"
  },
  {
   "i": 1227,
   "src": "4546e76ed6ff",
   "t": "¡Ladrón!"
  },
  {
   "i": 1235,
   "src": "4d47397c8bb1",
   "t": "¡¿Qué demonios?!"
  }
 ]
}
