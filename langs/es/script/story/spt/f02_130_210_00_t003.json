   "t": "{{ryoma}}"
  },
  {
   "i": 1045,
   "src": "b38c819f72fc",
   "t": "Espera."
  },
  {
   "i": 1056,
   "src": "92cb6d28f4ae",
   "t": "¿Qué rayos es ese bote?"
  },
  {
   "i": 1066,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1072,
   "src": "ae06e08d4f18",
   "t": "Ah, creo que aún no te lo conté."
  },
  {
   "i": 1075,
   "src": "9efd412bd7cb",
   "t": "Estábamos atascados, sin avanzar."
  },
  {
   "i": 1083,
   "src": "c94223f3315e",
   "t": "Hace nada, el {{medabot}}"
  },
  {
   "i": 1086,
   "src": "0426f1c55c89",
   "t": "de un compañero cayó allá."
  },
  {
   "i": 1094,
   "src": "32fb1f8bf847",
   "t": "Quiero ayudar, pero no tengo el valor"
  },
  {
   "i": 1097,
   "src": "5234e8b138e7",
   "t": "de saltar a estos rápidos sin remos..."
  },
  {
   "i": 1102,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1108,
   "src": "26f3a695c8ab",
   "t": "Ya veo."
  },
  {
   "i": 1116,
   "src": "9635b6e12bcd",
   "t": "Está bien, los llevaré allá,"
  },
  {
   "i": 1119,
   "src": "dd5005810897",
   "t": "pero no puedo garantizar su seguridad."
  },
  {
   "i": 1133,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1139,
   "src": "d82c9196d199",
   "t": "Ya veremos cómo nos arreglamos."
  },
  {
   "i": 1142,
   "src": "ea3bdeb699ba",
   "t": "Seguro saldrá bien, jajaja."
  },
  {
   "i": 1149,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1155,
   "src": "dcd48e30b2f3",
   "t": "Tan despreocupado como siempre."
  },
  {
   "i": 1158,
   "src": "0ab41ec6098c",
   "t": "...Bueno, da igual."
  }
 ]
