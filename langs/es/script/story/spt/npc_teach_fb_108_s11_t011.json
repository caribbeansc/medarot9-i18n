   "t": "{{ms_koimari}}"
  },
  {
   "i": 1038,
   "src": "d84e6c6aec3c",
   "t": "Creo que debería explicarles esto"
  },
  {
   "i": 1041,
   "src": "872324ae8849",
   "t": "como es debido..."
  },
  {
   "i": 1049,
   "src": "df380eaf36a7",
   "t": "El {{principal}} es casi todo máquina."
  },
  {
   "i": 1052,
   "src": "0bce1093dc41",
   "t": "Fue por un accidente; no sé más."
  },
  {
   "i": 1060,
   "src": "d3bb694c8f6e",
   "t": "Oír 'cíborg' suena fuerte, pero"
  },
  {
   "i": 1063,
   "src": "9b366fc04345",
   "t": "en realidad es lo contrario."
  },
  {
   "i": 1071,
   "src": "d2b4fa175a1b",
   "t": "Su cuerpo frágil apenas se mantiene."
  },
  {
   "i": 1074,
   "src": "f82e42263b23",
   "t": "Lo que quiero decir, en resumen..."
  },
  {
   "i": 1082,
   "src": "002c254a5d2d",
   "t": "Sé que ahora es duro, pero"
  },
  {
   "i": 1085,
   "src": "098516b3c491",
   "t": "no fuerces más al {{principal}}."
  },
  {
   "i": 1093,
   "src": "c03f41f80b78",
   "t": "Si no, podría volverse irreversible."
  },
  {
   "i": 1096,
   "src": "07b3b1b6c8b7",
   "t": "¿Entiendes?"
  }
 ]
