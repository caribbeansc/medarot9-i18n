   "t": "{{main}}"
  },
  {
   "i": 1348,
   "src": "3de1d310c9aa",
   "t": "¡¿Qué?!"
  },
  {
   "i": 1363,
   "src": "7be6c7cd85c8",
   "t": "¡Quiero desarmarlo!\n¡Quiero experimentar con él!"
  },
  {
