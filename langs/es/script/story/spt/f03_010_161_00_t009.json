   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1074,
   "src": "9e1e004d40f0",
   "t": "Tú eres el presidente, ¿no?"
  },
  {
   "i": 1084,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1093,
   "src": "6a1bef4da54e",
   "t": "Vaya, lo dejé ahí y me"
  },
  {
   "i": 1096,
   "src": "bc4065129894",
   "t": "olvidé por completo."
  },
  {
   "i": 1106,
