   "t": "{{ryoma}}"
  },
  {
   "i": 1112,
   "src": "d3d48b4a0026",
   "t": "Bueno,"
  },
  {
   "i": 1115,
   "src": "e589a0fbad0b",
   "t": "solo lo usé sin permiso..."
  },
  {
   "i": 1123,
   "src": "893d8e957a62",
   "t": "Ya que por fin tenemos más miembros,"
  },
  {
   "i": 1126,
   "src": "2c022d0d034f",
   "t": "podríamos compartirlo desde ahora."
  },
  {
   "i": 1134,
   "src": "d40ba72fc545",
   "t": "Así que puedo mirar esto y luego"
  },
  {
   "i": 1137,
   "src": "9ce0aae86fb4",
   "t": "'explorar' lo que me interese, ¿no?"
  },
  {
   "i": 1152,
