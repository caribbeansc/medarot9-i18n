{
 "file": "story/spt/f03_070_230_00_t001.spt",
 "lines": [
  {
   "i": 1038,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1049,
   "src": "589cd20ef050",
   "t": "Ya veo, así que es eso..."
  },
  {
   "i": 1060,
   "src": "65d1cd1c09dd",
   "t": "¿Qué pasa?"
  },
  {
   "i": 1065,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1071,
   "src": "8039ec2ada04",
   "t": "La valla está rota, ¿ves?"
  },
  {
   "i": 1079,
   "src": "270702788466",
   "t": "Antes no estaba así."
  },
  {
   "i": 1082,
   "src": "afd98dd37d75",
   "t": "En otras palabras--"
  },
  {
   "i": 1090,
   "src": "9c2dd818d47d",
   "t": "Hasta hace muy poco, no se podía"
  },
  {
   "i": 1093,
   "src": "c2e6012c4e52",
   "t": "entrar a la mina desde este punto."
  },
  {
   "i": 1101,
   "src": "59edc6dab2af",
   "t": "Esto... no se rompió de forma natural."
  },
  {
   "i": 1104,
   "src": "59911b49ca56",
   "t": "¿Alguien la rompió a propósito...?"
  },
  {
   "i": 1109,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1115,
   "src": "e4751a182444",
   "t": "Tal vez."
  },
  {
   "i": 1125,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1134,
   "src": "ad346ebad4e2",
   "t": "Bueno, no es para tanto."
  },
  {
   "i": 1145,
   "src": "a949333d72ae",
   "t": "Está bien ya, vámonos de una vez."
  },
  {
   "i": 1148,
   "src": "e7c1829cf2df",
   "t": "¡Yo quiero meterme al baño pronto!"
  },
  {
   "i": 1169,
   "src": "2a8905566226",
   "t": "Oh, qué es eso que veo más adelante..."
  },
  {
   "i": 1172,
   "src": "3f396c205238",
   "t": "¿No es el puerto?"
  },
  {
   "i": 1180,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1186,
   "src": "ddcf0ae44096",
   "t": "Así es. Si caminamos un poco,"
  },
  {
   "i": 1189,
   "src": "c004d8443c4a",
   "t": "veremos el edificio de la escuela."
  },
  {
   "i": 1200,
   "src": "e0fc361ae0c5",
   "t": "¡Vamos!"
  }
 ]
}
