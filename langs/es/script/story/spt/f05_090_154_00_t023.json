 "lines": [
  {
   "i": 1038,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1049,
   "src": "8ac12a219a11",
   "t": "¡Esta niña!"
  },
  {
   "i": 1056,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1065,
   "src": "d5797c07353b",
   "t": "Ya me acordé."
  },
  {
   "i": 1068,
   "src": "43a70ffbecbe",
   "t": "Así que era esta niña."
  },
  {
   "i": 1079,
   "src": "44c4fa2de7a3",
   "t": "¿...?"
  },
  {
   "i": 1084,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1090,
   "src": "bb334d17afd1",
   "t": "Ella es de 2do año. Estamos en clases"
  },
  {
   "i": 1093,
   "src": "fd3916d39a3f",
   "t": "diferentes, pero corrían rumores"
  },
  {
   "i": 1101,
   "src": "36a763fca566",
   "t": "que una chica brillante en mi grado "
  },
  {
   "i": 1104,
   "src": "00d9b303a22a",
   "t": "se saltó grados para entrar."
  },
  {
   "i": 1112,
   "src": "4d55cc856f60",
   "t": "¿Una niña prodigio que saltó grados?\nVaya."
  },
  {
   "i": 1117,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1123,
   "src": "26334b57f6b2",
   "t": "Solo se habló al ingresar. La olvidé,"
  },
  {
   "i": 1126,
   "src": "c79b90bd8956",
   "t": "creía que era una leyenda urbana..."
  }
 ]
