   "t": "{{mio}}"
  },
  {
   "i": 1038,
   "src": "01b201ec8568",
   "t": "¿Así que? ¿Qué tienes que decir?"
  },
  {
   "i": 1046,
   "src": "0b30dff1f696",
   "t": "Si tienes algo que decir, \n¡dilo de una vez!"
  },
  {
   "i": 1062,
   "src": "305a55e7acfe",
   "t": "{{aoi}}"
  },
  {
   "i": 1070,
   "src": "857a1ebe5635",
   "t": "Bailemos juntas, {{mio}}."
  },
  {
   "i": 1078,
   "src": "7e01c0f806c1",
   "t": "¡Originalmente esto era"
  },
  {
   "i": 1081,
   "src": "003a871e3e1f",
   "t": "un número para las cuatro!"
  },
  {
   "i": 1088,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1094,
   "src": "dfa1c9d1e222",
   "t": "¿Qué?"
  },
  {
   "i": 1102,
   "src": "22bc49c90703",
   "t": "¿Por qué ahora?"
  },
  {
   "i": 1105,
   "src": "235c0484c927",
   "t": "Deja de bromear."
  },
  {
   "i": 1112,
   "src": "305a55e7acfe",
   "t": "{{aoi}}"
  },
  {
   "i": 1118,
   "src": "0da772911a5e",
   "t": "¡No estoy bromeando!"
  },
  {
   "i": 1121,
   "src": "8730b0dd3a02",
   "t": "¡También tenemos los trajes listos!"
  },
  {
   "i": 1129,
   "src": "85b0514d77c3",
   "t": "Y la coreografía no era para dos,"
  },
  {
   "i": 1132,
   "src": "11dc95bc1b01",
   "t": "ensayamos la versión para cuatro."
  },
  {
   "i": 1140,
   "src": "318d8ac4b346",
   "t": "Desde que {{mio}} estaba en el {{idol_club}},"
  },
  {
   "i": 1143,
   "src": "86f926252e4e",
   "t": "he querido decírtelo."
  },
  {
   "i": 1150,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1156,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1163,
   "src": "305a55e7acfe",
   "t": "{{aoi}}"
  },
  {
   "i": 1169,
   "src": "46f210f80198",
   "t": "Perdón por tardar tanto."
  },
  {
   "i": 1172,
   "src": "29b76e171fa2",
   "t": "Hace rato que quería decírtelo..."
  },
  {
   "i": 1188,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1196,
   "src": "1ea9848f1bae",
   "t": "Los trajes."
  },
  {
   "i": 1203,
   "src": "305a55e7acfe",
   "t": "{{aoi}}"
  },
  {
   "i": 1209,
   "src": "4edf4a22891d",
   "t": "¿...Eh?"
  },
  {
   "i": 1218,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1224,
   "src": "e359bfb53bb1",
   "t": "Apúrate y dámelos de una vez."
  },
  {
   "i": 1227,
   "src": "508a9e46c175",
   "t": "Ya casi salimos, ¿no?"
  },
  {
   "i": 1234,
   "src": "305a55e7acfe",
   "t": "{{aoi}}"
  },
  {
   "i": 1240,
   "src": "7bcccdc7dfbe",
   "t": "{{mio}}..."
  },
  {
   "i": 1250,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1256,
   "src": "a323a7c014e7",
   "t": "Lo siento, pero... "
  },
  {
   "i": 1258,
   "src": "19ef1aeae1b7",
   "t": "--"
  },
  {
   "i": 1274,
   "src": "9288dc76ba71",
   "t": "Jeje, ya lo sabía."
  },
  {
   "i": 1277,
   "src": "3d524030c91e",
   "t": "Sabía que pasaría esto."
  },
  {
   "i": 1287,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1293,
   "src": "a6bac2547834",
   "t": "¡Sí, claro!"
  },
  {
   "i": 1314,
   "src": "c29ff6189123",
