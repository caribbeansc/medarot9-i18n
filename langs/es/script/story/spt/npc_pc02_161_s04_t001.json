  {
   "i": 1120,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1129,
   "src": "39eb530f04e8",
   "t": "Si ganas--"
  },
  {
   "i": 1132,
   "src": "0b36ddd2d5a8",
   "t": "Sí, el torneo es por eliminación."
  },
  {
   "i": 1143,
   "src": "4a0bc80dff15",
   "t": "Probablemente. Los torneos"
  },
  {
   "i": 1146,
