  {
   "i": 1035,
   "src": "4d60e33d6fe8",
   "t": "Oye, {{mio}}. Hay torneo."
  },
  {
   "i": 1038,
   "src": "5b10e894d5c9",
   "t": "¡Qué ganas le tengo!"
  },
  {
   "i": 1048,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
