  },
  {
   "i": 1065,
   "src": "a670749c592b",
   "t": "Oye"
  },
  {
   "i": 1068,
   "src": "1102129d6b12",
   "t": "Tengo una pregunta..."
  },
  {
   "i": 1079,
   "src": "504e8bc66809",
   "t": "¿Qué-qué?"
