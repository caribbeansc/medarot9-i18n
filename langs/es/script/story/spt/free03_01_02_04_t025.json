{
 "file": "story/spt/free03_01_02_04_t025.spt",
 "lines": [
  {
   "i": 1041,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1052,
   "src": "f3fc209df00f",
   "t": "Maldición, creí que por fin"
  },
  {
   "i": 1055,
   "src": "be0b0f2cdf4c",
   "t": "había hallado la entrada trasera."
  },
  {
   "i": 1066,
   "src": "abdff9d6b01a",
   "t": "Entrada trasera..."
  },
  {
   "i": 1069,
   "src": "7faa270b39db",
   "t": "¿Qué quiere decir con eso?"
  },
  {
   "i": 1077,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1083,
   "src": "ed6c161915b9",
   "t": "La entrada está en zona de"
  },
  {
   "i": 1086,
   "src": "c7cfa1730df3",
   "t": "la academia. Vetada a alumnos."
  },
  {
   "i": 1094,
   "src": "f0717d4ae09b",
   "t": "Pero por el tamaño de la {{mine}},"
  },
  {
   "i": 1097,
   "src": "33d8c0688bea",
   "t": "debió haber más de una entrada."
  },
  {
   "i": 1105,
   "src": "6175f23bd991",
   "t": "Seguro había galerías por toda la isla,"
  },
  {
   "i": 1108,
   "src": "3597db59b685",
   "t": "con pequeñas entradas por todas partes."
  },
  {
   "i": 1116,
   "src": "0900c860f958",
   "t": "Por eso busqué por todos lados..."
  },
  {
   "i": 1119,
   "src": "f271af653a8b",
   "t": "Ni siquiera hallaba un rastro."
  },
  {
   "i": 1130,
   "src": "6d8a1e48b2fd",
   "t": "Es el único lugar que hallé."
  },
  {
   "i": 1133,
   "src": "c8127c979ad4",
   "t": "Las demás las taparon al cerrar."
  },
  {
   "i": 1143,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1152,
   "src": "264dae2f314f",
   "t": "¿Taparlas? ¿Para qué molestarse?"
  },
  {
   "i": 1155,
   "src": "b90f97af3597",
   "t": "¿Con qué fin?"
  },
  {
   "i": 1162,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1171,
   "src": "55cd72a49099",
   "t": "No lo sé. Pero ningún registro de esa"
  },
  {
   "i": 1174,
   "src": "260a0f5980e4",
   "t": "época aparece por más que busque."
  },
  {
   "i": 1189,
   "src": "f0cc89c8cfd6",
   "t": "Quizá hay algo que quieren ocultar."
  },
  {
   "i": 1192,
   "src": "a5461642e849",
   "t": "Debe estar ligado a aquel accidente..."
  },
  {
   "i": 1200,
   "src": "74b625505d5f",
   "t": "¡Accidente!"
  },
  {
   "i": 1203,
   "src": "b7846cbaf882",
   "t": "Eso significa que--"
  },
  {
   "i": 1211,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1217,
   "src": "e0795a244490",
   "t": "Shhh."
  }
 ]
}
