{
 "file": "story/spt/f10_030_118_00_t014.spt",
 "lines": [
  {
   "i": 1034,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1045,
   "src": "1e1970cb81d3",
   "t": "Qué hacemos ahora."
  },
  {
   "i": 1059,
   "src": "bfa18efb41d9",
   "t": "{{select_corps_captain}}"
  },
  {
   "i": 1065,
   "src": "eb70e32900f8",
   "t": "Vigilaremos a la {{rubberobo_gang}}"
  },
  {
   "i": 1068,
   "src": "ea2ba2b9c08e",
   "t": "y los atraparemos en el momento justo."
  },
  {
   "i": 1075,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1081,
   "src": "f134e7ad9130",
   "t": "¿Por qué no actuar de inmediato?"
  },
  {
   "i": 1088,
   "src": "bfa18efb41d9",
   "t": "{{select_corps_captain}}"
  },
  {
   "i": 1094,
   "src": "fa37e618d788",
   "t": "Solo hay un puerto en la isla y"
  },
  {
   "i": 1097,
   "src": "4beadf6a847c",
   "t": "su barco también está anclado ahí."
  },
  {
   "i": 1109,
   "src": "b15dba7fb24d",
   "t": "Basta con esperar a que carguen el"
  },
  {
   "i": 1112,
   "src": "311948e8af7d",
   "t": "Medalium. Al zarpar, los detenemos"
  },
  {
   "i": 1120,
   "src": "6ae3083d9ad4",
   "t": "a todos de golpe. Por eso tenemos un"
  },
  {
   "i": 1123,
   "src": "1d8376c9fa38",
   "t": "barco anclado en alta mar. No hay prisa."
  },
  {
   "i": 1130,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1136,
   "src": "ba6826f23926",
   "t": "¿Piensas dejarlos tranquilos\nhasta que lo hayan desenterrado todo?"
  },
  {
   "i": 1150,
   "src": "bfa18efb41d9",
   "t": "{{select_corps_captain}}"
  },
  {
   "i": 1156,
   "src": "fe4760aef65e",
   "t": "Aun si los atacamos antes, solo"
  },
  {
   "i": 1159,
   "src": "6b8ddb1784c8",
   "t": "se dispersarán y huirán; sería ineficiente."
  },
  {
   "i": 1166,
   "src": "f71322c5c57d",
   "t": "{{principal|cap}}"
  },
  {
   "i": 1172,
   "src": "bd17fe36546c",
   "t": "Ignoremos a la {{rubberobo_gang}}."
  },
  {
   "i": 1175,
   "src": "6a506e6b1f7e",
   "t": "Lo urgente es detener la minería."
  },
  {
   "i": 1182,
   "src": "bfa18efb41d9",
   "t": "{{select_corps_captain}}"
  },
  {
   "i": 1188,
   "src": "36b740d291f5",
   "t": "Para evitar que el monstruo despierte"
  },
  {
   "i": 1191,
   "src": "a3246ef208c6",
   "t": "¿...es eso, verdad?"
  }
 ]
}
