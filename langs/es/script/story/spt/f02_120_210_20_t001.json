 "file": "story/spt/f02_120_210_20_t001.spt",
 "lines": [
  {
   "i": 1032,
   "src": "3f4a35c3542b",
   "t": "Espera, no huyas--"
  },
  {
   "i": 1046,
   "src": "55e9c5cf3275",
   "t": "No te acerques."
  },
  {
   "i": 1057,
   "src": "b1f4ebeb9958",
   "t": "¿Por qué no?"
  },
  {
   "i": 1060,
   "src": "114c0c58f043",
   "t": "{{mio}} está muy preocupada por ti..."
  },
  {
   "i": 1068,
   "src": "9b7a818b8fb7",
   "t": "¿Hay un motivo para no volver?"
  },
  {
   "i": 1071,
   "src": "5781cd84f781",
   "t": "Entonces, ¿por qué no nos lo dices?"
  },
  {
   "i": 1095,
   "src": "0f7d6f19b729",
   "t": "{{mio}} no lo entiende."
  },
  {
   "i": 1106,
   "src": "432ba9c1264a",
   "t": "¿Qué cosa?"
  },
  {
   "i": 1120,
   "src": "4756d4f46d5c",
   "t": "Por eso quiero que lo entienda."
  },
  {
   "i": 1123,
   "src": "8753c80c4261",
   "t": "Hasta entonces, yo--"
  }
 ]
