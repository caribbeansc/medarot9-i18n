 "lines": [
  {
   "i": 1026,
   "src": "3ac371823de8",
   "t": "{{council_pres_suzune}}"
  },
  {
   "i": 1037,
   "src": "a1eda12337f6",
   "t": "Aviso a todos los alumnos."
  },
  {
   "i": 1045,
   "src": "687f60d725ba",
   "t": "Derroten a los {{medabot|pl}} salvajes que"
  },
  {
   "i": 1048,
   "src": "40024b950c43",
   "t": "invadan la escuela en cuanto los vean."
  },
  {
   "i": 1056,
   "src": "04d1b74454dc",
   "t": "Sus puntos de entrada son el portón"
  },
  {
   "i": 1059,
   "src": "b6ac0ef850f8",
   "t": "y la zona tras los dormitorios."
  },
  {
   "i": 1067,
   "src": "5b0a24116030",
   "t": "También entraron unos pocos por"
  },
  {
   "i": 1070,
   "src": "4d3942d210e6",
   "t": "las ventanas de las aulas."
  },
  {
   "i": 1078,
   "src": "7daee21ab102",
   "t": "{{rescue_club}}, al portón. El {{club|cap}}"
  },
  {
   "i": 1081,
   "src": "02a72a5d8bce",
   "t": "{{medabot}}, al {{dormitory}}. ¡Intercepten!"
  },
  {
   "i": 1089,
   "src": "22fb90914da1",
   "t": "Que los demás clubes actúen"
  },
  {
   "i": 1092,
   "src": "7b299bb2ca26",
   "t": "a su propio criterio por ahora."
  },
  {
   "i": 1100,
   "src": "93a025017249",
   "t": "Les avisaré si hay cambios. "
  },
  {
   "i": 1103,
   "src": "995533852dee",
   "t": "Es todo."
  }
 ]
