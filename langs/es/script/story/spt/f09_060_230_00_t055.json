{
 "file": "story/spt/f09_060_230_00_t055.spt",
 "lines": [
  {
   "i": 1031,
   "src": "4f9055e32bb2",
   "t": "{{rubberobo_gang}}"
  },
  {
   "i": 1042,
   "src": "98f4e5a0f989",
   "t": "Sigue sin moverse ni un poco, {{robo}}."
  },
  {
   "i": 1056,
   "src": "e30cf7dd26ab",
   "t": "{{rubberobo_master}}"
  },
  {
   "i": 1065,
   "src": "fdeb8354e149",
   "t": "¡Es increíblemente resistente! "
  },
  {
   "i": 1068,
   "src": "c14695acdf84",
   "t": "¡Es como un refugio nuclear!"
  },
  {
   "i": 1082,
   "src": "8e9ad391ccf6",
   "t": "{{saika}}"
  },
  {
   "i": 1091,
   "src": "41ca7722e712",
   "t": "¡Qué exagerado! Aunque sí parece"
  },
  {
   "i": 1094,
   "src": "b6876a0981ef",
   "t": "imposible abrirla por la fuerza."
  },
  {
   "i": 1104,
   "src": "e30cf7dd26ab",
   "t": "{{rubberobo_master}}"
  },
  {
   "i": 1113,
   "src": "605240cb9b04",
   "t": "Si la fuerza no sirve, ¿qué vas a hacer?"
  },
  {
   "i": 1116,
   "src": "43c09d8128cb",
   "t": "¿Intentar seducirla?"
  },
  {
   "i": 1126,
   "src": "8e9ad391ccf6",
   "t": "{{saika}}"
  },
  {
   "i": 1135,
   "src": "3ec60f92011d",
   "t": "Debe haber un cierre en algún lado."
  },
  {
   "i": 1138,
   "src": "228ba68f6d09",
   "t": "Si lo hallo y lo desactivo..."
  },
  {
   "i": 1152,
   "src": "e30cf7dd26ab",
   "t": "{{rubberobo_master}}"
  },
  {
   "i": 1161,
   "src": "7854906e643c",
   "t": "Jaja, pues se abrirá, ¿no?"
  },
  {
   "i": 1164,
   "src": "b31149914f73",
   "t": "Si tan solo supiéramos cómo abrirla."
  },
  {
   "i": 1172,
   "src": "adef486bc778",
   "t": "Pero ¿cómo?"
  },
  {
   "i": 1180,
   "src": "8a9a19231590",
   "t": "¿Dónde estará el cierre en este"
  },
  {
   "i": 1183,
   "src": "cb04e1648548",
   "t": "liso y enorme muro, querida?"
  },
  {
   "i": 1190,
   "src": "8e9ad391ccf6",
   "t": "{{saika}}"
  },
  {
   "i": 1199,
   "src": "9697be04c44f",
   "t": "Cállate."
  },
  {
   "i": 1213,
   "src": "e30cf7dd26ab",
   "t": "{{rubberobo_master}}"
  },
  {
   "i": 1222,
   "src": "71b420a03878",
   "t": "¿Lo volamos todo para hallarlo?"
  },
  {
   "i": 1225,
   "src": "70177ac6ab4d",
   "t": "Eso pide una ojiva nuclear. ¡Jaja!"
  },
  {
   "i": 1239,
   "src": "8e9ad391ccf6",
   "t": "{{saika}}"
  },
  {
   "i": 1248,
   "src": "9d560033aa0c",
   "t": "¡Cállate, estoy pensando ahora mismo!"
  }
 ]
}
