   "t": "{{mio}}"
  },
  {
   "i": 1046,
   "src": "81717d09e9d8",
   "t": "Podrías dudar un poquito, ¿no?"
  },
  {
   "i": 1049,
   "src": "78b7119f8cf6",
   "t": "¡En serio!"
  },
  {
   "i": 1056,
