{
 "file": "story/spt/free06_01_01_03_t013.spt",
 "lines": [
  {
   "i": 1039,
   "src": "874222ee4554",
   "t": "Es una ruina magnífica, ¿no? Aunque,"
  },
  {
   "i": 1042,
   "src": "3dd376eb8452",
   "t": "llamarla 'magnífica' suena algo raro..."
  },
  {
   "i": 1050,
   "src": "7e8b01ba9b97",
   "t": "Debió ser un lugar muy animado."
  },
  {
   "i": 1053,
   "src": "95efbc88bad6",
   "t": "En aquel entonces..."
  },
  {
   "i": 1058,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1064,
   "src": "6aff32e6107d",
   "t": "Sí."
  },
  {
   "i": 1072,
   "src": "b33b2b89777a",
   "t": "Que una ciudad donde vivía tanta gente"
  },
  {
   "i": 1075,
   "src": "2da0f821d488",
   "t": "termine así en solo unas décadas..."
  },
  {
   "i": 1090,
   "src": "493f0c01cefb",
   "t": "Se siente increíblemente extraño."
  },
  {
   "i": 1095,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1101,
   "src": "88fa4dfa1c86",
   "t": "Es el destino de pueblos mineros."
  },
  {
   "i": 1104,
   "src": "571a7e9f3cba",
   "t": "Sin piedra, muere el pueblo."
  },
  {
   "i": 1111,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1117,
   "src": "143e3e3aed14",
   "t": "¿Será de verdad así?"
  },
  {
   "i": 1128,
   "src": "4edf4a22891d",
   "t": "¿...Eh?"
  },
  {
   "i": 1133,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1139,
   "src": "21e8e90acb3d",
   "t": "¿No has oído hablar del accidente?"
  },
  {
   "i": 1147,
   "src": "6f6107a90532",
   "t": "Eh..."
  },
  {
   "i": 1152,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1158,
   "src": "5cb8d7f57d83",
   "t": "Dicen que hubo un gran accidente."
  },
  {
   "i": 1161,
   "src": "83afacef4f28",
   "t": "Casi no salió en las noticias."
  },
  {
   "i": 1169,
   "src": "dacf45f0901b",
   "t": "Si revisas los pocos registros,"
  },
  {
   "i": 1172,
   "src": "3f23d3767806",
   "t": "se ve que cerró tras el accidente."
  },
  {
   "i": 1182,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1188,
   "src": "6db008e763ea",
   "t": "¿El accidente cerró la mina? ¿No"
  },
  {
   "i": 1191,
   "src": "6ab7d0cba047",
   "t": "fue por agotarse las {{medalia|pl}}...?"
  },
  {
   "i": 1201,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1207,
   "src": "263adadf9c35",
   "t": "Mmm."
  },
  {
   "i": 1210,
   "src": "9a54921e75b8",
   "t": "Creí que era una posibilidad."
  },
  {
   "i": 1237,
   "src": "f50ff39ba4eb",
   "t": "En fin. Tampoco es algo de lo que"
  },
  {
   "i": 1240,
   "src": "c924300f0a5f",
   "t": "tengamos que hablar justo ahora."
  },
  {
   "i": 1251,
   "src": "c2a838ad31f5",
   "t": "¿Volvemos antes de que oscurezca?"
  }
 ]
}
