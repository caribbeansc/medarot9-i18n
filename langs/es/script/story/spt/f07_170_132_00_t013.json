{
 "file": "story/spt/f07_170_132_00_t013.spt",
 "lines": [
  {
   "i": 1042,
   "src": "60e4437ad225",
   "t": "¿Eh?"
  },
  {
   "i": 1045,
   "src": "df0c9be73466",
   "t": "¿Ya está todo bien por allá?"
  },
  {
   "i": 1053,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1059,
   "src": "b847463d1651",
   "t": "Fue tan popular que no tenía fin,"
  },
  {
   "i": 1062,
   "src": "98a14c73e739",
   "t": "así que repartimos sin {{robattle}}."
  },
  {
   "i": 1072,
   "src": "d5ffc2c5cce7",
   "t": "{{main}}"
  },
  {
   "i": 1081,
   "src": "ec81d4d4000a",
   "t": "¡Entregué contraseñas a 128 personas!"
  },
  {
   "i": 1095,
   "src": "dbd6845b1d96",
   "t": "Vaya."
  },
  {
   "i": 1098,
   "src": "95567712a1da",
   "t": "Debió ser todo un trabajo."
  },
  {
   "i": 1106,
   "src": "cc0584a6ce59",
   "t": "..."
  },
  {
   "i": 1117,
   "src": "575c70ae7859",
   "t": "Me pregunto si todos las usarán."
  },
  {
   "i": 1125,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1131,
   "src": "f54a7b7b448c",
   "t": "Quién sabe... quizá se olviden para"
  },
  {
   "i": 1134,
   "src": "1dde17668bf3",
   "t": "mañana. Como un premio de feria."
  },
  {
   "i": 1144,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1150,
   "src": "269db5741103",
   "t": "Qué cosas tan románticas dices."
  },
  {
   "i": 1161,
   "src": "18ea577677ee",
   "t": "Bueno, al menos ya tenemos algo"
  },
  {
   "i": 1164,
   "src": "ff8819ef01ef",
   "t": "que mostrar. A mí me da igual."
  },
  {
   "i": 1179,
   "src": "7c7a2a500403",
   "t": "Con esto aguanto un buen rato más,\n¿no?"
  },
  {
   "i": 1187,
   "src": "c8e9eb2c4b69",
   "t": "Siento que oí"
  },
  {
   "i": 1190,
   "src": "e5f6bde09b37",
   "t": "eso hace poco--"
  }
 ]
