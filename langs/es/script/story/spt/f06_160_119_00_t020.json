 "lines": [
  {
   "i": 1024,
   "src": "8e9ad391ccf6",
   "t": "{{saika}}"
  },
  {
   "i": 1035,
   "src": "45d633e8bdeb",
   "t": "Hagan lo que quieran."
  },
  {
   "i": 1046,
   "src": "9856e9164319",
   "t": "Pueden entrar por esta puerta,"
  },
  {
   "i": 1049,
   "src": "b007c993dd47",
   "t": "o pueden marcharse en silencio."
  },
  {
   "i": 1057,
   "src": "903fcb01be5c",
   "t": "Aunque decidan marcharse,"
  },
  {
   "i": 1060,
   "src": "500f028932a5",
   "t": "les aseguro que no habrá problemas."
  },
  {
   "i": 1071,
   "src": "cb85a0491d28",
   "t": "Oye, tú."
  },
  {
   "i": 1082,
   "src": "9161497b1498",
   "t": "Eh, ¿yo?"
  },
  {
   "i": 1087,
   "src": "8e9ad391ccf6",
   "t": "{{saika}}"
  },
  {
   "i": 1096,
   "src": "80ccbc5d10f4",
   "t": "Sostén la puerta por mí."
  },
  {
   "i": 1099,
   "src": "3d3e4d1c90af",
   "t": "Esta se cierra con seguro automático."
  }
 ]
