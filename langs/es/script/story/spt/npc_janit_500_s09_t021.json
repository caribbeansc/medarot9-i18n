   "t": "{{janitor_character}}"
  },
  {
   "i": 1038,
   "src": "e93b96e3b648",
   "t": "¿Pero qué pasa con esos? Van vestidos"
  },
  {
   "i": 1041,
   "src": "e83bb9336289",
   "t": "de negro, como unos tétricos"
  },
  {
   "i": 1049,
   "src": "0933dd6864ff",
   "t": "espantapájaros. Llevaban rondando"
  },
  {
   "i": 1052,
   "src": "5e6c6e6103f7",
   "t": "aquí, pero hoy llegó un montón"
  },
  {
   "i": 1060,
   "src": "5d380d91278f",
   "t": "de ellos. Tienen pases de puerto, pero"
  },
  {
   "i": 1063,
   "src": "fe1c65b7199d",
   "t": "no parecen del personal. Tampoco"
  },
  {
   "i": 1071,
   "src": "4420e0fa6064",
   "t": "parecen peces gordos de un gran"
  },
  {
   "i": 1074,
   "src": "136db9d444d7",
   "t": "consorcio. Quiénes serán de verdad."
  }
 ]
