  },
  {
   "i": 1044,
   "src": "624dd9fc032e",
   "t": "Según los documentos guardados"
  },
  {
   "i": 1047,
   "src": "e5cbe39c2642",
   "t": "en el cristal con los planos del detector,"
  },
  {
   "i": 1055,
   "src": "d30f4a263aba",
   "t": "la {{medalia}}, en origen, no sería"
  },
  {
   "i": 1058,
   "src": "07283ef947a6",
   "t": "el cristal redondo que conocemos."
  },
  {
   "i": 1066,
   "src": "c9d3c7609f10",
   "t": "Lo que llamamos {{medalia}} sería,"
  },
  {
   "i": 1069,
   "src": "155143411176",
   "t": "al parecer, una {{medalia}} recristalizada."
  },
  {
   "i": 1077,
   "src": "04509718d69c",
   "t": "Recristalizada..."
  },
  {
   "i": 1092,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1098,
   "src": "b368003fd97a",
   "t": "Sí."
  },
  {
   "i": 1106,
   "src": "8f36d686a696",
   "t": "{{medalia}} disuelta en el agua subterránea"
  },
  {
   "i": 1109,
   "src": "de448931e7c5",
   "t": "se juntó con el tiempo y recristalizó."
  },
  {
   "i": 1119,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1125,
   "src": "ba2bedc5ee11",
   "t": "O sea, ¿la fuente de lo que se disuelve--"
  },
  {
   "i": 1128,
   "src": "ff15c386bc18",
   "t": "...está en algún lugar de la isla?"
  },
  {
   "i": 1138,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1144,
   "src": "54688b792bc6",
   "t": "Si 'está',"
  },
  {
   "i": 1147,
   "src": "437807345ba3",
   "t": "o 'estaba', eso no lo sé."
  },
  {
   "i": 1155,
   "src": "7a7c8b6fbe56",
   "t": "Al menos, este sistema de {{detect}}"
  },
  {
   "i": 1158,
   "src": "a98d559f6ae9",
   "t": "se hizo para explorar esa posibilidad."
  },
  {
   "i": 1174,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1185,
   "src": "3f63f8f03034",
   "t": "¿Por qué te guardaste algo tan\nimportante todo este tiempo?"
  },
  {
   "i": 1195,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1204,
   "src": "de0666fc8804",
   "t": "¿Hace cuántas décadas crees que fue?"
  },
  {
   "i": 1207,
   "src": "ce23639b8ba3",
   "t": "Si la hipótesis es cierta, ya se agotó."
  },
  {
   "i": 1215,
   "src": "130dc9e2d062",
   "t": "O si no, la hipótesis está equivocada."
  },
  {
   "i": 1218,
   "src": "a076df3408e1",
   "t": "Pensaba que sería una de las dos."
  },
  {
   "i": 1236,
   "src": "a440e6513c6e",
   "t": "Entonces no tendrá relación con... ese--"
  },
  {
   "i": 1244,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1250,
   "src": "634537a3e7a8",
   "t": "{{medalium}}."
  },
  {
   "i": 1258,
   "src": "8d29e95e4f50",
   "t": "Sí, podría ser un nuevo filón de"
  },
  {
   "i": 1261,
   "src": "ed7f4c77fd77",
   "t": "{{medalia}}, ajeno al Medalium, quizá..."
  },
  {
   "i": 1276,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1285,
   "src": "0019c38900c7",
   "t": "¡El {{principal}} lo enterró en secreto!"
  },
  {
   "i": 1295,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1304,
   "src": "7c5f89e438a5",
   "t": "!?"
  },
  {
   "i": 1315,
   "src": "e0e2301e9d4b",
   "t": "Ah, ya veo. Bueno, eso sin duda"
  },
  {
   "i": 1318,
