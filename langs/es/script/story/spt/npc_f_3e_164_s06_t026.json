   "t": "{{ginrei}}"
  },
  {
   "i": 1035,
   "src": "7384a2e31611",
   "t": "Cuanto más parecidas las combines,"
  },
  {
   "i": 1038,
   "src": "9768bdfea2e5",
   "t": "más fuerte sale, ya lo sabes, ¿no?"
  },
  {
   "i": 1046,
   "src": "048e32261dc5",
   "t": "Pero también pasa lo contrario."
  },
  {
   "i": 1049,
   "src": "51a8ee73ca71",
   "t": "Por ejemplo, si"
  },
  {
   "i": 1057,
