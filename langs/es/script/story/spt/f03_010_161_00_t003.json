   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1042,
   "src": "4fd73e5748a5",
   "t": "Qué."
  },
  {
   "i": 1045,
   "src": "bade3a9ed24d",
   "t": "¿¡Será esto una {{medalia}}!?"
  },
  {
   "i": 1053,
   "src": "1bcff332be0c",
   "t": "¿¡Una de verdad!?"
  },
  {
   "i": 1067,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1076,
   "src": "aa1953d80b7e",
   "t": "Sí."
  },
  {
   "i": 1084,
   "src": "a950d27423c0",
   "t": "¿La halló en esta isla? ¿Eh?"
  },
  {
   "i": 1087,
   "src": "325c585bb53e",
   "t": "Pero creí que ya se había agotado..."
  },
  {
   "i": 1092,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1098,
   "src": "15a89380e6b0",
   "t": "No queda lo justo para ser rentable."
  },
  {
   "i": 1101,
   "src": "4d4edf20a982",
   "t": "Pero aún hallas algo para ti mismo."
  },
  {
   "i": 1109,
   "src": "7bdbba10a0fa",
   "t": "Las hallas al vencer {{medabot|pl}} salvajes,"
  },
  {
   "i": 1112,
   "src": "3eefb6d1e332",
   "t": "o con suerte, en los arbustos. "
  },
  {
   "i": 1127,
   "src": "9f5abfbf10e8",
   "t": "¡Genial! Si junto estas y las vendo,"
  },
  {
   "i": 1130,
   "src": "0b645ca36e16",
   "t": "nadaría en dinero en poco tiempo-"
  },
  {
   "i": 1140,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1146,
   "src": "ee75c8eaf376",
   "t": "Vaya, vender cosas que conseguiste"
  },
  {
   "i": 1149,
   "src": "bf5505e1cddb",
   "t": "en actividades del {{club}} está prohibido."
  },
  {
   "i": 1160,
   "src": "84a21ca39d2a",
   "t": "Si rompes esto, no será solo"
  },
  {
   "i": 1163,
   "src": "d0edd3a96f6f",
   "t": "la disolución del club. Cuidado, todos."
  },
  {
   "i": 1173,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1182,
   "src": "b639ec02c423",
   "t": "Ah, ya veo."
  }
 ]
