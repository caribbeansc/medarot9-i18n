  },
  {
   "i": 1260,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1266,
   "src": "4b95446a5938",
   "t": "Sí, es increíble."
  },
  {
   "i": 1274,
   "src": "ea2f1a01bb8c",
   "t": "¡Estoy muy emocionado desde entonces"
  },
  {
   "i": 1277,
   "src": "06ad4cf425c1",
   "t": "porque es simplemente increíble!"
  },
  {
   "i": 1284,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1293,
   "src": "ab58371c3364",
   "t": "Aunque no lo pareces, la verdad."
  },
  {
   "i": 1303,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1312,
   "src": "19967a51e60e",
   "t": "Pero hay un problema."
  },
  {
   "i": 1320,
   "src": "a1b27f841d44",
