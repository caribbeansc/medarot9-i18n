  },
  {
   "i": 1328,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1334,
   "src": "a6c2b21a583f",
   "t": "Entender y reconstruir este {{blueprint}}"
  },
  {
   "i": 1337,
   "src": "cad24277e0de",
   "t": "requiere mucho conocimiento."
  },
  {
   "i": 1352,
   "src": "77feb89be518",
   "t": "Al menos yo, no tendría ni idea."
  },
  {
   "i": 1355,
   "src": "7a5d2746e482",
   "t": "Jajaja."
  },
  {
   "i": 1362,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1368,
   "src": "17b333643cbe",
   "t": "En concreto"
  },
  {
   "i": 1371,
   "src": "9ddc49360f54",
   "t": "¿qué tipo de conocimiento se necesita?"
  },
  {
   "i": 1381,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1387,
   "src": "ba62f2c0e3d8",
   "t": "No sé mucho, pero al menos"
  },
  {
   "i": 1390,
   "src": "f857dc80a5f6",
   "t": "ingeniería de {{medabot|pl}}."
  },
  {
   "i": 1398,
   "src": "9c65a7776b7b",
   "t": "Y física, química, matemáticas,"
  },
  {
   "i": 1401,
   "src": "7d328c3643e0",
   "t": "y más ciencia avanzada hace falta."
  },
  {
   "i": 1415,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1424,
   "src": "e45adfafc04c",
   "t": "O sea que es imposible, eh."
  },
  {
   "i": 1431,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1440,
   "src": "8175d2e2c1e4",
   "t": "No, no, en nuestra escuela se reúnen"
  },
  {
   "i": 1443,
   "src": "b6bf1f924e9d",
   "t": "élites de todo el mundo, ¿verdad?"
  },
  {
   "i": 1451,
   "src": "6d7a1f097410",
   "t": "Entre los becados nunca sabes"
  },
  {
   "i": 1454,
   "src": "c7d46ac07557",
   "t": "qué genios podrían esconderse~."
  },
  {
   "i": 1461,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
