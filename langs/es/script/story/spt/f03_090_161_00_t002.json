   "t": "En realidad..."
  },
  {
   "i": 1058,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1064,
   "src": "0e7a1c985432",
   "t": "¿Algo que contar?"
  },
  {
   "i": 1067,
   "src": "8287a320f7d6",
   "t": "Bueno, como sea."
  },
  {
   "i": 1082,
   "src": "8d0b7bd3f88e",
