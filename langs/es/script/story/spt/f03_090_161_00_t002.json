  {
   "i": 1087,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1093,
   "src": "5b5d0a3a8c3f",
   "t": "Escucha, ¿recuerdas ese cristal de"
  },
  {
   "i": 1096,
   "src": "5edd9a272de8",
   "t": "memoria que encontramos el otro día?"
  },
  {
   "i": 1104,
   "src": "f1c913191adf",
   "t": "Por fin logré extraer los datos."
  },
  {
   "i": 1111,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1117,
   "src": "c6fc309e47a3",
   "t": "Vaya."
  },
  {
   "i": 1125,
   "src": "b97ae930fc27",
   "t": "Y, ¿qué había dentro?"
  },
  {
   "i": 1135,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1141,
   "src": "298935dec5be",
   "t": "El {{blueprint}} de un {{medalia_detector}}."
  },
  {
   "i": 1148,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1154,
   "src": "6ab6e7a9cd63",
   "t": "¡¿Qué?!"
  },
  {
   "i": 1163,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1169,
   "src": "e0ce965c09c8",
   "t": "Parece que la {{medalia}} es"
  },
  {
   "i": 1172,
   "src": "53458e66071a",
   "t": "algo que se puede detectar."
  },
  {
   "i": 1179,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1185,
   "src": "e9e9e3510d7d",
   "t": "¿Cómo funciona?"
  },
  {
   "i": 1188,
   "src": "97da82b8e46c",
   "t": "¿Es como un radar?"
  },
  {
   "i": 1195,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1201,
   "src": "6f5fb476031f",
   "t": "Parece que es algo distinto."
  },
  {
   "i": 1204,
   "src": "eaafba69e757",
   "t": "Se parece más a un contador Geiger."
  },
  {
   "i": 1212,
   "src": "cfff93e5b8f7",
   "t": "La {{medalia}} tiene una {{react}} única"
  },
  {
   "i": 1215,
   "src": "512c7beeaf1a",
   "t": "y esto puede detectarla."
  },
  {
   "i": 1222,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1228,
   "src": "1f4ffda7960e",
   "t": "Así que, ¿con este aparato hallas la"
  },
  {
   "i": 1231,
   "src": "e0228e703a9a",
   "t": "ubicación de la {{medalia}} sin verla?"
  },
  {
   "i": 1238,
   "src": "f1f3a69763ae",
   "t": "{{exploration_club_pres_kunigiku}}"
  },
  {
   "i": 1244,
   "src": "517c802ada4b",
   "t": "Así es."
  },
  {
   "i": 1252,
   "src": "ff7c946c7f7d",
