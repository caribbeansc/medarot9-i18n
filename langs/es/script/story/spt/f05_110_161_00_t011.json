 "file": "story/spt/f05_110_161_00_t011.spt",
 "lines": [
  {
   "i": 1136,
   "src": "af2d83be2423",
   "t": "¿Un buen {{master}}?"
  },
  {
   "i": 1154,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1165,
   "src": "802443a33f5d",
   "t": "Eso es obvio, ¿no? Un maestro"
  },
  {
   "i": 1168,
   "src": "a383a6eea2fb",
   "t": "que es buen amigo de su {{medabot}}."
  },
  {
   "i": 1186,
   "src": "35a4d3851911",
   "t": "Como nosotros."
  },
  {
   "i": 1189,
   "src": "a670749c592b",
   "t": "Verdad, "
  },
  {
   "i": 1191,
   "src": "e52afecfbed9",
   "t": "?"
  },
  {
   "i": 1214,
   "src": "be8f55742378",
   "t": "Sí."
  },
  {
   "i": 1217,
   "src": "ec28de7b2b99",
   "t": "Me alegra que {{mio}} sea mi maestra."
  },
  {
   "i": 1232,
   "src": "ca62e341ee50",
   "t": "Por eso {{mio}} es una buena maestra."
  },
  {
   "i": 1250,
   "src": "cc0584a6ce59",
   "t": "......"
  },
  {
   "i": 1258,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1264,
   "src": "9079bcd0a53d",
   "t": "Sé lo que estás pensando "
  },
  {
   "i": 1266,
   "src": "7d9d809ecbf1",
   "t": "."
  },
  {
   "i": 1269,
   "src": "dca124396e7a",
   "t": "Pero no lo hagas."
  },
  {
   "i": 1280,
   "src": "54916a17c3fa",
   "t": "¿Eh?"
  },
  {
   "i": 1288,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1294,
   "src": "1b89914dbfb1",
   "t": "Ni siquiera saben los criterios para\naprobar o reprobar."
  },
  {
   "i": 1302,
   "src": "73c2761156ed",
   "t": "Si fuera algo fácil de preparar,"
  },
  {
   "i": 1305,
   "src": "74375fc810ff",
   "t": "el profe no avisaría de antemano."
  },
  {
   "i": 1320,
   "src": "7fda69d6bff7",
   "t": "Un parche rápido solo saldrá mal."
  },
  {
   "i": 1328,
   "src": "28ceb9c13abf",
   "t": "No hagas cosas innecesarias, que"
  },
  {
   "i": 1332,
   "src": "07f22df0c861",
   "t": " se va a confundir."
  },
  {
   "i": 1340,
   "src": "dc87661f9b2d",
   "t": "S-sí..."
  }
 ]
}
