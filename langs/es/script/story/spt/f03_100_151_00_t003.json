 "lines": [
  {
   "i": 1042,
   "src": "4dcebdf4005a",
   "t": "Es un torneo de {{robattle|pl}}, "
  },
  {
   "i": 1044,
   "src": "3a56fd31ee59",
   "t": "!"
  },
  {
   "i": 1066,
   "src": "a89ffaadae28",
   "t": "¡Torneo de {{robattle|pl}}!"
  },
  {
   "i": 1082,
   "src": "f6a6664df2b2",
   "t": "¿Qué es un torneo?"
  },
  {
   "i": 1090,
   "src": "9ce9797eae16",
   "t": "Vamos a tener muchas {{robattle|pl}}"
  },
  {
   "i": 1093,
   "src": "6dbaf2029449",
   "t": "para ver quién es el más fuerte."
  },
  {
   "i": 1112,
   "src": "6ab6e7a9cd63",
   "t": "¡¿Qué?!"
  },
  {
   "i": 1115,
   "src": "3a7604bc8267",
   "t": "¿¡Para decidir quién es el más fuerte!?"
  },
  {
   "i": 1136,
   "src": "b633c1d72e2e",
   "t": "¡Yo quiero entrar a eso!"
  },
  {
   "i": 1139,
   "src": "5cdb51285e42",
   "t": "¡Yo entro!"
  },
  {
   "i": 1145,
   "src": "388e1710e8ad",
   "t": "¿Está bien si yo participo?"
  },
  {
   "i": 1148,
   "src": "6723abc68acc",
   "t": "¡Quiero participar!"
  },
  {
   "i": 1164,
   "src": "83829141775b",
   "t": "No te preocupes. Mañana"
  },
  {
   "i": 1167,
   "src": "8f85861b0773",
   "t": "podrás participar quieras o no."
  },
  {
   "i": 1186,
   "src": "7ed8e0ff75db",
   "t": "¿En serio?"
  },
  {
   "i": 1189,
   "src": "3336519ee906",
   "t": "Muy bien, ¡voy a ser el mejor!"
  },
  {
   "i": 1197,
   "src": "d27d788dc006",
   "t": "El mejor, eh."
  },
  {
   "i": 1200,
   "src": "54058200649c",
   "t": "¡Ojalá pueda lograrlo...!"
  }
 ]
