 "file": "story/spt/free06_02_01_02_t031.spt",
 "lines": [
  {
   "i": 1031,
   "src": "e30cf7dd26ab",
   "t": "{{rubberobo_master}}"
  },
  {
   "i": 1042,
   "src": "a4094e5536a1",
   "t": "Agh..."
  },
  {
   "i": 1057,
   "src": "b055b50ea379",
   "t": "Bah, como sea. Si te fijas bien,"
  },
  {
   "i": 1060,
   "src": "d3a0054ce062",
   "t": "este edificio no tiene nada de especial."
  },
  {
   "i": 1068,
   "src": "42e053a3ae0e",
   "t": "Pisos y paredes destrozados, y las"
  },
  {
   "i": 1071,
   "src": "15d2c87a7431",
   "t": "vías y vagonetas, oxidadas."
  },
  {
   "i": 1079,
   "src": "cd4d0cd65dae",
   "t": "Hacer un escondite en un sitio así,"
  },
  {
   "i": 1082,
   "src": "225b30f21dc6",
   "t": "solo la reforma me dejaría en la ruina."
  },
  {
   "i": 1090,
   "src": "ebbd5b370c3b",
   "t": "Bah, olvídalo, olvídalo."
  },
  {
   "i": 1093,
   "src": "0604fe637087",
   "t": "Les regalo este lugar a ustedes."
  },
  {
   "i": 1108,
   "src": "51377b62a6b5",
   "t": "¡Tuviste suerte, mocoso!"
  },
  {
   "i": 1111,
   "src": "4bbcbb186742",
   "t": "¡Nos vemos!"
  }
 ]
}
