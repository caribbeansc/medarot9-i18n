 "lines": [
  {
   "i": 1041,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1052,
   "src": "f3fc209df00f",
   "t": "...Maldición, pensé que por fin había"
  },
  {
   "i": 1055,
   "src": "be0b0f2cdf4c",
   "t": "encontrado la entrada trasera."
  },
  {
   "i": 1063,
   "src": "abdff9d6b01a",
   "t": "Entrada trasera..."
  },
  {
   "i": 1074,
   "src": "ccce830957ef",
   "t": "¿La 'entrada principal' es la cueva al"
  },
  {
   "i": 1077,
   "src": "ff383270171a",
   "t": "final del ducto que sale del almacén?"
  },
  {
   "i": 1082,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1091,
   "src": "f8aea04d82a0",
   "t": "¿Si te acercas mucho, un {{medabot}}\nextraño te ataca?"
  },
  {
   "i": 1101,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1110,
   "src": "ddcf0ae44096",
   "t": "Así es."
  },
  {
   "i": 1118,
   "src": "f0717d4ae09b",
   "t": "Pero dado el tamaño de la {{mine}},"
  },
  {
   "i": 1121,
   "src": "33d8c0688bea",
   "t": "no podía haber solo esa entrada."
  },
  {
   "i": 1129,
   "src": "6175f23bd991",
   "t": "Seguro había galerías por la isla,"
  },
  {
   "i": 1132,
   "src": "3597db59b685",
   "t": "con entradas a la {{mine}} por doquier."
  },
  {
   "i": 1140,
   "src": "0900c860f958",
   "t": "Pensando eso, recorrí todo el lugar..."
  },
  {
   "i": 1143,
   "src": "f271af653a8b",
   "t": "Pero ni siquiera hallé rastro alguno."
  },
  {
   "i": 1154,
   "src": "6d8a1e48b2fd",
   "t": "Por fin la encontré aquí."
  },
  {
   "i": 1157,
   "src": "c8127c979ad4",
   "t": "Las demás las taparon al cerrar."
  },
  {
   "i": 1167,
   "src": "1e52ed43bbf1",
   "t": "{{mio}}"
  },
  {
   "i": 1176,
   "src": "264dae2f314f",
   "t": "¿Las taparon? ¿A propósito?"
  },
  {
   "i": 1179,
   "src": "b90f97af3597",
   "t": "¿Para qué?"
  },
  {
   "i": 1193,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1202,
   "src": "55cd72a49099",
   "t": "No lo sé. Pero no hay registro"
  },
  {
   "i": 1205,
   "src": "260a0f5980e4",
   "t": "de esa época por más que busque."
  },
  {
   "i": 1213,
   "src": "f0cc89c8cfd6",
   "t": "Quizá hay algo que quieren ocultar."
  },
  {
   "i": 1216,
   "src": "a5461642e849",
   "t": "Debe estar ligado a aquel accidente..."
  },
  {
   "i": 1224,
   "src": "74b625505d5f",
   "t": "¡Accidente!"
  },
  {
   "i": 1227,
   "src": "b7846cbaf882",
   "t": "Eso significa que--"
  },
  {
   "i": 1235,
   "src": "c12c268fadf2",
   "t": "{{ryoma}}"
  },
  {
   "i": 1241,
   "src": "e0795a244490",
   "t": "Shh."
  }
 ]
}
