 "file": "story/spt/f09_240_800_00_t011.spt",
 "lines": [
  {
   "i": 1010,
   "src": "79205ef7f921",
   "t": "Sí."
  },
  {
   "i": 1013,
   "src": "2a19dd4dd7b9",
   "t": "Yo..."
  },
  {
   "i": 1028,
   "src": "f98a069de6a0",
   "t": "No sirvo para ser {{master}}."
  },
  {
   "i": 1036,
   "src": "23d786a0947d",
   "t": "Cuando empecé a llevarme bien con él,"
  },
  {
   "i": 1039,
   "src": "4e614faded31",
   "t": "me confié de más, o algo así."
  },
  {
   "i": 1047,
   "src": "04c34ba1e3b3",
   "t": "Sin notarlo, creía que "
  },
  {
   "i": 1049,
   "src": "0242a31d76a0",
   "t": " me"
  },
  {
   "i": 1052,
   "src": "105b90fc71dd",
   "t": "haría caso, como algo natural..."
  },
  {
   "i": 1077,
   "src": "8d3438531844",
   "t": "Desde el principio, supongo."
  },
  {
   "i": 1085,
   "src": "0ee6cee3216a",
   "t": "Creí que lo estaba haciendo bien..."
  },
  {
   "i": 1088,
   "src": "2484a057c507",
   "t": "Quizá yo era el único que lo pensaba."
  },
  {
   "i": 1096,
   "src": "b3e59b5530b4",
   "t": "Tal vez "
  },
  {
   "i": 1098,
   "src": "9862fb13b84e",
   "t": " se ha sentido"
  },
  {
   "i": 1101,
   "src": "82a57234ba2e",
   "t": "desde que nos conocimos, me vio así--"
  }
 ]
}
