   "t": "{{ryusei}}"
  },
  {
   "i": 1145,
   "src": "7498d1e46398",
   "t": "¿Eh?"
  },
  {
   "i": 1153,
   "src": "a7412e08b8b0",
   "t": "¡Dispara a los objetivos y si tumbas más"
