+// Test harness (local build): log and dismiss any visible modal dialog so automated runs can
+// never hang on an error/warning box. The text goes to user/log/harness_dialogs.txt.
+static void HarnessDismissDialogs() {
+    for (QWidget* widget : QApplication::topLevelWidgets()) {
+        auto* dialog = qobject_cast<QDialog*>(widget);
+        if (!dialog || !dialog->isVisible()) {
+            continue;
+        }
+        auto* box = qobject_cast<QMessageBox*>(widget);
+        QString text;
+        if (box) {
+            text = box->text() + QStringLiteral(" | ") + box->informativeText() +
+                   QStringLiteral(" | ") + box->detailedText();
+        }
+        const std::string line = fmt::format("[harness] dialog '{}' ({}): {}",
+                                             dialog->windowTitle().toStdString(),
+                                             dialog->metaObject()->className(), text.toStdString());
+        LOG_WARNING(Frontend, "{}", line);
+        {
+            std::ofstream out(FileUtil::GetUserPath(FileUtil::UserPath::LogDir) +
+                                  "harness_dialogs.txt",
+                              std::ios::app);
+            out << line << std::endl;
+        }
+        if (box) {
+            if (box->escapeButton()) {
+                box->escapeButton()->click();
+            } else if (box->defaultButton()) {
+                box->defaultButton()->click();
+            } else {
+                box->done(QMessageBox::Cancel);
+            }
+        } else {
+            dialog->reject();
+        }
+    }
+}
