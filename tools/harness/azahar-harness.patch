+// ---------------------------------------------------------------------------------------------
+// Test-harness extensions (local build). Deterministic control for automated game testing:
+// input injection, PNG screenshots, frame stepping, save states and emulation speed.
+// ---------------------------------------------------------------------------------------------
+
+u64 RPCServer::CurrentFrame() {
+    if (!system.IsPoweredOn()) {
+        return 0;
+    }
+    return system.GPU().Renderer().GetCurrentFrame();
+}
+
+u32 RPCServer::AdvanceFramesBlocking(u32 frames, u32 timeout_ms) {
+    auto& limiter = system.frame_limiter;
+    if (!limiter.IsFrameAdvancing()) {
+        limiter.SetFrameAdvancing(true);
+    }
+    u32 done = 0;
+    for (; done < frames; ++done) {
+        if (!system.IsPoweredOn()) {
+            break;
+        }
+        // Wait for ANY change of the frame counter: loading a save state can move it backwards.
+        const u64 before = CurrentFrame();
+        limiter.AdvanceFrame();
+        const auto deadline =
+            std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+        while (CurrentFrame() == before) {
+            if (std::chrono::steady_clock::now() > deadline) {
+                return done;
+            }
+            std::this_thread::sleep_for(std::chrono::microseconds(100));
+        }
+    }
+    return done;
+}
+
+void RPCServer::HandleSetInput(Packet& packet, u32 buttons, u32 flags, std::span<const u8> extra) {
+    auto& input = Harness::GetInputOverride();
+    s16 circle_x = 0, circle_y = 0;
+    u16 touch_x = 0, touch_y = 0;
+    if (extra.size() >= 8) {
+        std::memcpy(&circle_x, extra.data(), 2);
+        std::memcpy(&circle_y, extra.data() + 2, 2);
+        std::memcpy(&touch_x, extra.data() + 4, 2);
+        std::memcpy(&touch_y, extra.data() + 6, 2);
+    }
+    input.buttons = buttons;
+    input.circle_x = circle_x;
+    input.circle_y = circle_y;
+    input.circle_override = (flags & 2) != 0;
+    input.touch_x = touch_x;
+    input.touch_y = touch_y;
+    input.touch_pressed = (flags & 4) != 0;
+    input.enabled = (flags & 1) != 0;
+    packet.SetPacketDataSize(0);
+    packet.SendReply();
+}
+
+void RPCServer::HandleScreenshot(Packet& packet, u32 res_scale, std::span<const u8> path_bytes) {
+    u32 ok = 0;
+    const std::string path(reinterpret_cast<const char*>(path_bytes.data()), path_bytes.size());
+    if (system.IsPoweredOn() && !path.empty()) {
+        if (res_scale == 0) {
+            res_scale = 1;
+        }
+        struct ShotState {
+            std::vector<u8> bgra;
+            std::promise<bool> done;
+        };
+        const auto layout = Layout::FrameLayoutFromResolutionScale(res_scale, false);
+        auto state = std::make_shared<ShotState>();
+        state->bgra.resize(static_cast<std::size_t>(layout.width) * layout.height * 4);
+        auto future = state->done.get_future();
+        // The callback keeps the buffer alive even if we time out here.
+        system.GPU().Renderer().RequestScreenshot(
+            state->bgra.data(), [state](bool invert_y) { state->done.set_value(invert_y); },
+            layout);
+        if (system.frame_limiter.IsFrameAdvancing()) {
+            AdvanceFramesBlocking(1, 3000);
+        }
+        if (future.wait_for(std::chrono::seconds(10)) == std::future_status::ready) {
+            const bool invert_y = future.get();
+            const u32 w = layout.width, h = layout.height;
+            std::vector<u8> rgba(state->bgra.size());
+            for (u32 y = 0; y < h; ++y) {
+                const u32 src_y = invert_y ? (h - 1 - y) : y;
+                const u8* src = state->bgra.data() + static_cast<std::size_t>(src_y) * w * 4;
+                u8* dst = rgba.data() + static_cast<std::size_t>(y) * w * 4;
+                for (u32 x = 0; x < w; ++x) {
+                    dst[x * 4 + 0] = src[x * 4 + 2];
+                    dst[x * 4 + 1] = src[x * 4 + 1];
+                    dst[x * 4 + 2] = src[x * 4 + 0];
+                    dst[x * 4 + 3] = 0xFF;
+                }
+            }
+            ok = lodepng::encode(path, rgba, w, h) == 0 ? 1 : 0;
+        } else {
+            LOG_ERROR(RPC_Server, "Harness screenshot timed out");
+        }
+    }
+    std::memcpy(packet.GetPacketData().data(), &ok, sizeof(ok));
+    packet.SetPacketDataSize(sizeof(ok));
+    packet.SendReply();
+}
+
+void RPCServer::HandleRunFrames(Packet& packet, u32 frames, u32 timeout_ms) {
+    const u32 done = AdvanceFramesBlocking(frames, timeout_ms == 0 ? 5000 : timeout_ms);
+    const u64 frame = CurrentFrame();
+    u8* out = packet.GetPacketData().data();
+    std::memcpy(out, &frame, sizeof(frame));
+    std::memcpy(out + sizeof(frame), &done, sizeof(done));
+    packet.SetPacketDataSize(sizeof(frame) + sizeof(done));
+    packet.SendReply();
+}
+
+void RPCServer::HandleStateOp(Packet& packet, bool load, u32 slot) {
+    // Save/load states are serviced by the emulation loop and (for loads) need the emulation to run
+    // freely: frame advancing would deadlock the load. Release it, wait for frames to flow again and
+    // restore the previous stepping mode.
+    auto& limiter = system.frame_limiter;
+    const bool was_advancing = limiter.IsFrameAdvancing();
+    if (was_advancing) {
+        limiter.SetFrameAdvancing(false);
+    }
+    u32 ok = system.SendSignal(load ? Core::System::Signal::Load : Core::System::Signal::Save,
+                               slot)
+                 ? 1
+                 : 0;
+    if (ok) {
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+        u64 last = CurrentFrame();
+        int changes = 0;
+        while (std::chrono::steady_clock::now() < deadline && changes < 4) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+            const u64 f = CurrentFrame();
+            if (f != last) {
+                last = f;
+                ++changes;
+            }
+        }
+        if (changes < 4) {
+            ok = 0;
+        }
+    }
+    if (was_advancing) {
+        limiter.SetFrameAdvancing(true);
+    }
+    std::memcpy(packet.GetPacketData().data(), &ok, sizeof(ok));
+    packet.SetPacketDataSize(sizeof(ok));
+    packet.SendReply();
+}
+
+void RPCServer::HandleSetSpeed(Packet& packet, u32 percent) {
+    Settings::is_temporary_frame_limit = true;
+    Settings::temporary_frame_limit = static_cast<double>(percent);
+    packet.SetPacketDataSize(0);
+    packet.SendReply();
+}
+
+void RPCServer::HandleStatus(Packet& packet) {
+    const u64 frame = CurrentFrame();
+    const u32 advancing = system.frame_limiter.IsFrameAdvancing() ? 1 : 0;
+    const u32 powered = system.IsPoweredOn() ? 1 : 0;
+    u8* out = packet.GetPacketData().data();
+    std::memcpy(out, &frame, 8);
+    std::memcpy(out + 8, &advancing, 4);
+    std::memcpy(out + 12, &powered, 4);
+    packet.SetPacketDataSize(16);
+    packet.SendReply();
+}
